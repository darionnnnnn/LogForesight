<?xml version="1.0" encoding="utf-8" ?>
<!--
  Web 的診斷 log。檔名帶日期、每天一個檔（回饋二十八輪 P11）——
  單一 web.log 靠大小輪替時，要回頭查「上週三那次跑批」得先猜它落在第幾個歸檔檔。
  另外把 Warn 以上分流到獨立的 error 檔：平常要看的是「有沒有出事」，
  在混著 Info 的檔案裡撈例外太費事（docs/BACKLOG.md 也記過這個需求）。
  error 的內容在兩個檔案都有——完整時序留在 web 檔，單獨追錯用 error 檔。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogToConsole="true"
      internalLogLevel="Warn">

    <extensions>
        <add assembly="NLog.Web.AspNetCore" />
    </extensions>

    <variable name="lfLayout"
              value="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${aspnet-user-identity}|${message}${onexception:${newline}${exception:format=ToString}}" />

    <targets>
        <!-- 檔名的 ${shortdate} 就是每日切檔的機制；archiveAboveSize 只是同一天內爆量時的第二道保險，
             切出來的序號檔仍帶當天日期。maxArchiveFiles 只清同一天的序號檔，
             跨日的舊檔由 maxArchiveDays 依天數清理 -->
        <target xsi:type="File" name="webfile"
                fileName="${basedir}/logs/web-${shortdate}.log"
                archiveFileName="${basedir}/logs/archive/web-${shortdate}.{#}.log"
                archiveNumbering="Sequence"
                archiveAboveSize="10485760"
                maxArchiveFiles="20"
                maxArchiveDays="90"
                encoding="utf-8"
                layout="${lfLayout}" />

        <target xsi:type="File" name="errorfile"
                fileName="${basedir}/logs/error-${shortdate}.log"
                archiveFileName="${basedir}/logs/archive/error-${shortdate}.{#}.log"
                archiveNumbering="Sequence"
                archiveAboveSize="10485760"
                maxArchiveFiles="20"
                maxArchiveDays="90"
                encoding="utf-8"
                layout="${lfLayout}" />

        <target xsi:type="Console" name="console"
                layout="${time}|${level:uppercase=true}|${message}${onexception: ${exception:format=Message}}" />
    </targets>

    <rules>
        <!-- 框架自身的 Info 訊息量大且對排查沒有幫助，只留 Warn 以上 -->
        <logger name="Microsoft.*" maxlevel="Info" final="true" />
        <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

        <logger name="*" minlevel="Info" writeTo="webfile" />
        <logger name="*" minlevel="Warn" writeTo="errorfile" />
        <logger name="*" minlevel="Info" writeTo="console" />
    </rules>
</nlog>
