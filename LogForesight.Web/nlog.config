<?xml version="1.0" encoding="utf-8" ?>
<!--
  Web 的診斷 log。每天一個檔（回饋二十八輪 P11）——單一 web.log 靠大小輪替時，
  要回頭查「上週三那次跑批」得先猜它落在第幾個歸檔檔。
  另外把 Warn 以上分流到獨立的 error 檔：平常要看的是「有沒有出事」，
  在混著 Info 的檔案裡撈例外太費事。錯誤內容兩邊都有——完整時序留在 web 檔，
  單獨追錯用 error 檔。

  日切用 archiveEvery="Day" 而不是把 ${shortdate} 放進 fileName：
  後者跨日是「另開新檔」而非「歸檔」，maxArchiveDays/maxArchiveFiles 管不到
  這些主檔，logs/ 會無上限成長。標準組合是主檔名固定、歸檔檔名帶日期，
  跨日時 NLog 把昨天的內容搬進 archive/ 並套用保留上限。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogToConsole="true"
      internalLogLevel="Warn">

    <extensions>
        <add assembly="NLog.Web.AspNetCore" />
    </extensions>

    <variable name="lfLayout"
              value="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${aspnet-user-identity}|${message}${onexception:${newline}${exception:format=ToString}}" />

    <targets>
        <!-- archiveAboveSize 是同一天內爆量時的第二道保險；跨日的舊檔由 maxArchiveDays 清理 -->
        <target xsi:type="File" name="webfile"
                fileName="${basedir}/logs/web.log"
                archiveFileName="${basedir}/logs/archive/web-{#}.log"
                archiveNumbering="Date"
                archiveDateFormat="yyyy-MM-dd"
                archiveEvery="Day"
                archiveAboveSize="10485760"
                maxArchiveDays="90"
                encoding="utf-8"
                layout="${lfLayout}" />

        <target xsi:type="File" name="errorfile"
                fileName="${basedir}/logs/error.log"
                archiveFileName="${basedir}/logs/archive/error-{#}.log"
                archiveNumbering="Date"
                archiveDateFormat="yyyy-MM-dd"
                archiveEvery="Day"
                archiveAboveSize="10485760"
                maxArchiveDays="90"
                encoding="utf-8"
                layout="${lfLayout}" />

        <target xsi:type="Console" name="console"
                layout="${time}|${level:uppercase=true}|${message}${onexception: ${exception:format=Message}}" />
    </targets>

    <rules>
        <!-- 框架自身的 Info 訊息量大且對排查沒有幫助，只留 Warn 以上 -->
        <logger name="Microsoft.*" maxlevel="Info" final="true" />
        <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

        <logger name="*" minlevel="Info" writeTo="webfile" />
        <logger name="*" minlevel="Warn" writeTo="errorfile" />
        <logger name="*" minlevel="Info" writeTo="console" />
    </rules>
</nlog>
