{
  // ════════════════════════════════════════════════════════════════════════════
  //  LogForesight.Web 設定
  //
  //  ★ 本檔只保留「站台還沒起來、資料庫還沒連上之前就必須知道」的啟動與安全前提:
  //    Storage（資料庫在哪）、Jwt（簽章金鑰）、Auth（登入方式與本地救援帳號）。
  //    其餘可調整項目一律以「系統管理 > 設定」頁（資料庫）為唯一事實來源——
  //    AI 位址與進階參數、權限監控資料夾、分析參數（伺服器角色/體檢間隔/掃描頻道）、
  //    匯入上限、保留天數、AD 驗證伺服器,都在該頁調整,改完即時生效、不必重啟站台。
  //    （回饋第九輪 §12 精簡;NetIQ 連線與節流參數在「NetIQ 維護」頁。）
  //
  //  ★ 開箱即可登入:用 IIS Express / `dotnet run` 啟動（會以 Development 環境執行）
  //    即可直接登入。兩個測試帳號（Provider=Stub 免密碼）:
  //        demo-admin   ← 開箱測試管理員（顯示名稱「測試管理員」,自動 seed,有 admin 全能力,
  //                        測儀表板/問題查詢/報表/處理指派等全站功能請用這個）
  //        svc-lfadmin  ← 本地救援帳號,只有維護與稽核能力,不看業務資料（見 WEB-SPEC §6.2）
  //    （Provider=Stub 時免密碼發生在後端:登入頁照常顯示密碼欄、照常輸入,但後端一律通過驗證。
  //      demo-admin 僅在 Stub 且非 Production 時 seed;LogForesight-dev 是 svc-lfadmin 在
  //      正式模式下的測試密碼,對應下方 PasswordHash,Stub 模式不需要用到它。）
  //
  //  ★★★【正式環境務必修改，以下為已知的測試值，切勿沿用】★★★
  //    這個檔會進版控與 GitHub,SecretKey / PasswordHash 是「公開已知」的測試值。
  //    部署到真實伺服器前務必:
  //      1. Auth:Provider 改成 "Ad"（Stub 不驗密碼;正式環境用 Stub 啟動時會被直接擋下）,
  //         再以 serverAdmin 登入後至「系統管理 > 設定」頁啟用 AD 驗證並填入伺服器位址。
  //      2. 以環境變數覆寫機密（不要把真實金鑰寫回本檔）:
  //           Jwt__SecretKey                     ← 另外產生的 ≥32 bytes 隨機字串
  //           Auth__ServerAdmin__PasswordHash    ← LogForesight.Web.exe --hash-password 產生
  //      3. Storage:DataRoot 視需要指向共用資料目錄（預設用本站台執行檔目錄即可）。
  //  （本檔支援 // 註解與尾逗號。存檔請用 UTF-8。）
  // ════════════════════════════════════════════════════════════════════════════

  "Storage": {
    // Type＝儲存後端。二選一:
    //   "Sqlite"    預設值。單一 .db 檔的真資料庫,測試/開發用。
    //               ConnectionString 空 = 自動用 {DataRoot}\Db\logforesight.db。
    //   "SqlServer" 正式環境（2000 台量級）。ConnectionString 必填,建議用環境變數
    //               Storage__ConnectionString 覆寫,不要把連線字串寫回本檔。
    // 全部資料走資料庫,DataRoot 只用來決定 Sqlite 檔位置與交付檔案（export\ 報告全文）的所在。
    //
    // DataRoot 空字串＝本站台自己的執行檔目錄（測試可直接啟動）。
    // 若要與另一個共用目錄的資料庫/檔案交換,在 appsettings.Development.json 覆寫這個路徑。
    "Type": "Sqlite",
    "DataRoot": "",
    "ConnectionString": ""
  },

  "Jwt": {
    "Issuer": "LogForesight",
    "Audience": "LogForesight.Web",
    // 【正式環境需修改】HMAC-SHA256 簽章金鑰（≥32 bytes）。
    // 下面這組是「公開已知」的測試值,僅供本機測試——正式環境用環境變數 Jwt__SecretKey 覆寫。
    "SecretKey": "bge6V8SsJu6GRuYYyVniemo/XhAJ4J3kis3sqSDai5gluW9wmA2Vnd4opTbXBTxo",
    "ExpireHours": 8,
    "CookieName": "lf_auth"
  },

  "Auth": {
    // 驗證方式二選一:
    //   "Ad"   正式環境用。AD 伺服器位址等設定的唯一事實來源是「系統管理 > 設定」頁;
    //          尚未設定前只有 serverAdmin 進得來（它不經任何驗證方式,正是為此存在）。
    //   "Stub" 測試用,不驗密碼。正式環境用 Stub 啟動會被擋下。
    // 【正式環境需修改】改成 "Ad"。
    "Provider": "Stub",
    "ServerAdmin": {
      // 本地救援帳號:指派 admin 成員、AD 停擺時的入口。
      "Account": "svc-lfadmin",
      // 【正式環境需修改】PBKDF2 雜湊,以 LogForesight.Web.exe --hash-password 產生。
      // 下面這組對應明文密碼 = LogForesight-dev（公開已知的測試值,僅供本機測試）;
      // 正式環境用環境變數 Auth__ServerAdmin__PasswordHash 覆寫。
      "PasswordHash": "PBKDF2$210000$s79Mzbz0FKaArA2SsMlCuQ==$2JKMIZGXFQbelisLIZZo+WAMCPJ0Ao3XPm5jg8TFy9M=",
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },

  "AllowedHosts": "*"
}
