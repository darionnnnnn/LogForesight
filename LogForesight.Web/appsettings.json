{
  // ════════════════════════════════════════════════════════════════════════════
  //  LogForesight.Web 設定
  //
  //  ★ 本檔已內含「開箱即可登入」的測試預設值——用 IIS Express / `dotnet run` 啟動
  //    （會以 Development 環境執行）即可直接登入:
  //        帳號:svc-lfadmin  密碼:任意輸入或留空皆可
  //    （Provider=Stub 時免密碼發生在後端:登入頁照常顯示密碼欄、照常輸入,但後端一律通過驗證,
  //      含本地救援管理員 svc-lfadmin。LogForesight-dev 是 svc-lfadmin 在正式 Ldap 模式下的
  //      測試密碼,對應下方 PasswordHash;Stub 模式不需要用到它。）
  //
  //  ★★★【正式環境務必修改，以下為已知的測試值，切勿沿用】★★★
  //    這個檔會進版控與 GitHub,SecretKey / PasswordHash 是「公開已知」的測試值。
  //    部署到真實伺服器前務必:
  //      1. Auth:Provider 改成 "Ldap"（Stub 不驗密碼;正式環境用 Stub 啟動時會被直接擋下）。
  //      2. 以環境變數覆寫機密（不要把真實金鑰寫回本檔）:
  //           Jwt__SecretKey                     ← 另外產生的 ≥32 bytes 隨機字串
  //           Auth__ServerAdmin__PasswordHash    ← LogForesight.Web.exe --hash-password 產生
  //      3. Storage:DataRoot 視需要指向共用資料目錄（預設用本站台執行檔目錄即可）。
  //      4. Auth:Ldap:Domain 填入 AD 網域名稱。
  //  （本檔支援 // 註解與尾逗號。存檔請用 UTF-8。）
  // ════════════════════════════════════════════════════════════════════════════

  "Storage": {
    // Type＝儲存後端。二選一:
    //   "Sqlite"    預設值。單一 .db 檔的真資料庫,測試/開發用。
    //               ConnectionString 空 = 自動用 {DataRoot}\logforesight.db。
    //   "SqlServer" 正式環境（2000 台量級）。ConnectionString 必填,建議用環境變數
    //               Storage__ConnectionString 覆寫,不要把連線字串寫回本檔。
    // 全部資料走資料庫,DataRoot 只用來決定 Sqlite 檔位置與交付檔案（export\ 報告全文）的所在。
    //
    // DataRoot 空字串＝本站台自己的執行檔目錄（測試可直接啟動）。
    // 若要與另一個共用目錄的資料庫/檔案交換,在 appsettings.Development.json 覆寫這個路徑。
    "Type": "Sqlite",
    "DataRoot": "",
    "ConnectionString": ""
  },

  // 排程觸發分析時使用的參數。AI 位址／金鑰仍以「系統管理 > 設定」
  // 頁（DB）為事實來源，這裡只是 DB 尚未設定時的退路（開箱即用）；本區段其餘欄位（逾時/重試/
  // 頻道等）沒有 DB 對應項，維持檔案設定。「排程作業」尚未啟用（Enabled=false）時本區段不生效。
  "Ai": {
    "BaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 600,
    "RetryCount": 3,
    "RetryDelaySeconds": 10,
    "JsonRetryCount": 2,
    "MaxTokens": 1536,
    "DeepDiveMaxTokens": 8192,
    "ExtraRequestFields": {
      "chat_template_kwargs": { "enable_thinking": false },
      "rep_pen": 1.3
    },
    "FrequencyPenalty": 0.8,
    "PresencePenalty": 0.8
  },

  "Permissions": {
    // 額外要監控權限異動的資料夾（本站台執行檔自身目錄一律自動監控，不必列在此）。
    "WatchedFolders": []
  },

  "Analysis": {
    // 伺服器角色描述，會帶入 prompt 讓 AI 依環境判讀。留空＝略過。
    "ServerDescription": "",
    "CheckupIntervalDays": 7,
    // 要掃描的 Event Log 頻道全名清單。空清單＝使用預設六頻道。
    "Channels": []
  },

  "Jwt": {
    "Issuer": "LogForesight",
    "Audience": "LogForesight.Web",
    // 【正式環境需修改】HMAC-SHA256 簽章金鑰（≥32 bytes）。
    // 下面這組是「公開已知」的測試值,僅供本機測試——正式環境用環境變數 Jwt__SecretKey 覆寫。
    "SecretKey": "bge6V8SsJu6GRuYYyVniemo/XhAJ4J3kis3sqSDai5gluW9wmA2Vnd4opTbXBTxo",
    "ExpireHours": 8,
    "CookieName": "lf_auth"
  },

  "Auth": {
    // 驗證方式:Stub（測試,不驗密碼）或 Ldap（AD 帳密）。
    // 【正式環境需修改】改成 "Ldap"——正式環境用 Stub 啟動時會被擋下。
    "Provider": "Stub",
    "ServerAdmin": {
      // 本地救援帳號:指派 admin 成員、AD 停擺時的入口。
      "Account": "svc-lfadmin",
      // 【正式環境需修改】PBKDF2 雜湊,以 LogForesight.Web.exe --hash-password 產生。
      // 下面這組對應明文密碼 = LogForesight-dev（公開已知的測試值,僅供本機測試）;
      // 正式環境用環境變數 Auth__ServerAdmin__PasswordHash 覆寫。
      "PasswordHash": "PBKDF2$210000$s79Mzbz0FKaArA2SsMlCuQ==$2JKMIZGXFQbelisLIZZo+WAMCPJ0Ao3XPm5jg8TFy9M=",
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Ldap": {
      // 【正式環境需修改】Provider=Ldap 時必填 AD 網域名稱,如 corp.local。
      "Domain": ""
    }
  },

  "Import": {
    "MaxFileSizeKb": 2048,
    "MaxRows": 5000
  },

  "Ui": {
    "DefaultPageSize": 50,
    "DashboardDefaultDays": 7,
    "RunMatrixDays": 14
  },

  "Netiq": {
    // NetIQ 掃描匯入精靈要用哪個主機探索實作:
    //   "Auto"（預設）沿用環境判斷:Development 用離線示範資料、其餘用真連線 Sentinel。
    //   "Stub" 強制離線示範資料（固定台數/網段數,非真實掃描）。
    //   "Real" 強制真連線 Sentinel——開發機要對真實 Sentinel 試掃時設這個。
    // 正式環境不允許設為 "Stub"（會被 Validate 擋下啟動）。
    "DiscoveryClient": "Auto"
  },

  "AllowedHosts": "*"
}
