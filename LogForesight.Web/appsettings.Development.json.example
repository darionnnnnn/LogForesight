{
  // 本機開發設定範本：複製為 appsettings.Development.json 後填入實際值。
  // 該檔已列入 .gitignore（內含金鑰與密碼雜湊），不會進版本控制。
  // 提示：本倉庫的 appsettings.Development.json 已附一組可直接測試的預設值
  //       （帳號 svc-lfadmin / 密碼 LogForesight-dev），照抄即可，或依下列步驟自訂。
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    // 預設 "Sqlite"：開發／測試走真資料庫，與正式 SQL Server 語意一致。
    "Type": "Sqlite",
    // DataRoot 留空即可：退回本站台自己的執行檔目錄（StorageSettings.ResolveDataRoot()）——
    // Web 排程／立即執行是現在唯一的分析執行途徑，資料本來就該落在 Web 自己的目錄下。
    // 只有要讀「別處」的資料時才需在此明確填絕對路徑（填的目錄必須存在，否則啟動驗證會 fail fast）。
    // SQLite 模式下 DataRoot 也決定 Db\logforesight.db 的落點。
    // ⚠ repo 位於 OneDrive 同步範圍時，同步掃檔可能與 SQLite 鎖檔衝突（偶發 database is locked）；
    //   長時間測試建議把 DataRoot 指到 OneDrive 之外（如 "C:\\LogForesightData-dev"）。
    "DataRoot": ""
  },
  "Jwt": {
    // HMAC-SHA256 簽章金鑰，至少 32 bytes。可用 PowerShell 產生：
    // [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
    "SecretKey": "<至少 32 bytes 的隨機字串>"
  },
  "Auth": {
    "Provider": "Stub",
    "ServerAdmin": {
      "Account": "svc-lfadmin",
      // 以 LogForesight.Web.exe --hash-password 產生（測試可用任意自訂的已知密碼）
      "PasswordHash": "<PBKDF2 雜湊>"
    }
  }
  // NetIQ 掃描一律預設真實連線（回饋第九輪 §13 起 appsettings 不再有 Netiq 區段）：
  // 需要離線示範資料時到「系統管理 > NetIQ 維護」頁開啟「使用離線示範資料」開關（僅非 Production 可開）。
}
