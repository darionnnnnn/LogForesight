@{
    ViewData["Title"] = "規則維護";
}

<div class="lf-hint mb-3">
    <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#info-circle"></use></svg>
    <span>規則儲存前會自動驗證，不合格不會寫入。</span>
    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
            data-bs-title="關於規則維護"
            data-bs-content="儲存前會自動執行驗證（欄位合格、Id 重複、規則遮蔽），不合格不會寫入。停用規則只關掉「規則命中的分類與知識庫」，趨勢層與關聯層對同一事件的偵測不受影響。">
        <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
    </button>
</div>

@* 內建規則升級橫幅（docs/archive/WEB-SCHEDULER-PLAN.md §1.4.9，承接 --import-rules）：只在庫內版本落後時出現 *@
<div class="alert alert-info d-flex justify-content-between align-items-center d-none" id="rule-import-banner">
    <span id="rule-import-banner-text"></span>
    <button type="button" class="btn btn-sm btn-outline-primary" id="rule-import-preview-btn">預覽差異</button>
</div>

<ul class="nav nav-tabs mb-3" id="rule-tabs">
    <li class="nav-item"><button class="nav-link active" data-tab="rules" data-platform="windows" type="button">Windows規則</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="rules" data-platform="linux" type="button">Linux規則</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="suppressions" type="button">告警抑制</button></li>
</ul>

<section data-panel="rules">
    <div class="lf-toolbar">
        <div class="lf-toolbar__row">
            <div class="lf-toolbar__search">
                <input type="search" class="form-control form-control-sm" id="rule-search" placeholder="搜尋來源、Event ID、說明" />
            </div>
            <div class="lf-toolbar__spacer"></div>
            <button type="button" class="btn btn-sm btn-primary" id="btn-new-rule">新增規則</button>
        </div>
        <div class="lf-toolbar__row">
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">狀態</span>
                <div class="lf-toolbar__chips" id="rule-status-chips"></div>
            </div>
            <div class="lf-toolbar__divider"></div>
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">來源</span>
                <div class="lf-toolbar__chips" id="rule-origin-chips"></div>
            </div>
            <div class="lf-toolbar__divider"></div>
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">抑制</span>
                <div class="lf-toolbar__chips" id="rule-suppression-chips"></div>
            </div>
        </div>
        <div class="lf-toolbar__row">
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">嚴重度</span>
                <div class="lf-toolbar__chips" id="rule-severity-chips"></div>
            </div>
            <div class="lf-toolbar__divider"></div>
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">類別</span>
                <div class="lf-toolbar__chips" id="rule-category-chips"></div>
            </div>
            <div class="lf-toolbar__divider"></div>
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">重大</span>
                <div class="lf-toolbar__chips" id="rule-elevates-chips"></div>
            </div>
        </div>
    </div>

    <div class="lf-card">
        <div class="lf-card__header">
            <h2 class="lf-card__title">規則 <span class="text-muted small" id="rule-count"></span></h2>
        </div>
        <div class="lf-card__body p-0" id="rule-list"></div>
        <div class="lf-card__body pt-0">
            <nav id="rule-pager"></nav>
        </div>
    </div>
</section>

<section data-panel="suppressions" class="d-none">
    <div class="lf-toolbar">
        <div class="lf-toolbar__row">
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">平台</span>
                <div class="lf-toolbar__chips" id="suppression-platform-chips"></div>
            </div>
            <div class="lf-toolbar__group">
                <span class="lf-toolbar__group-label">目標</span>
                <div class="lf-toolbar__chips" id="suppression-target-type-chips"></div>
            </div>
        </div>
    </div>
    <div class="lf-card">
        <div class="lf-card__header">
            <h2 class="lf-card__title">告警抑制</h2>
            <span class="text-muted small">抑制只關掉通知與風險升級，事件仍照常聚合與紀錄</span>
        </div>
        <div class="lf-card__body p-0" id="suppression-list"></div>
        <div class="lf-card__body pt-0">
            <nav id="suppression-pager"></nav>
        </div>
    </div>
</section>

<!-- 規則編輯 -->
<div class="modal fade" id="rule-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rule-modal-title">規則</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="rule-form" novalidate>
                <div class="modal-body">
                    <div id="rule-validation"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="rule-id" class="form-label">規則 Id <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="rule-id" required />
                            <div class="form-text" id="rule-id-hint">新規則必須以 custom- 開頭。</div>
                        </div>
                        <div class="col-md-6" id="rule-match-windows-source" data-platform-block="windows">
                            <label for="rule-source" class="form-label">來源比對 <span class="text-danger">*</span></label>
                            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                    data-bs-content="Event Log 的來源名稱，例如 disk、Ntfs。">
                                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                            </button>
                            <input type="text" class="form-control" id="rule-source" />
                        </div>

                        <div class="col-md-6" id="rule-match-windows-ids" data-platform-block="windows">
                            <label for="rule-event-ids" class="form-label">Event ID</label>
                            <input type="text" class="form-control" id="rule-event-ids" placeholder="7, 11, 51" />
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="rule-match-all" />
                                <label class="form-check-label" for="rule-match-all">
                                    比對此來源的全部事件（不看 Event ID）
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6" id="rule-match-linux-program" data-platform-block="linux">
                            <label for="rule-program" class="form-label">Program 比對</label>
                            <input type="text" class="form-control" id="rule-program" placeholder="sshd、sudo、kernel" />
                            <div class="form-text">syslog identifier／process 名稱，與 EventNamePattern 至少填一個。</div>
                        </div>
                        <div class="col-md-6" id="rule-match-linux-eventname" data-platform-block="linux">
                            <label for="rule-event-name" class="form-label">正規化事件名（選填）</label>
                            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                    data-bs-content="Sentinel 有做事件正規化時可用此欄，命中即算，不需再比對訊息。">
                                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                            </button>
                            <input type="text" class="form-control" id="rule-event-name" />
                        </div>
                        <div class="col-12" id="rule-match-linux-messages" data-platform-block="linux">
                            <label for="rule-message-patterns" class="form-label">訊息子字串（一行一項，任一命中即算，最多 8 條）</label>
                            <textarea class="form-control" id="rule-message-patterns" rows="3" placeholder="Failed password&#10;authentication failure"></textarea>
                            <div class="form-text">留空＝不看訊息內容，Program 命中就算（如帳號異動類事件）。</div>
                        </div>

                        <div class="col-md-3">
                            <label for="rule-category" class="form-label">類別</label>
                            <select class="form-select" id="rule-category">
                                <option value="Storage">儲存裝置</option>
                                <option value="Hardware">硬體</option>
                                <option value="Security">安全</option>
                                <option value="Service">服務</option>
                                <option value="Resource">資源</option>
                                <option value="Backup">備份</option>
                                <option value="Config">設定</option>
                                <option value="Other">其他</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="rule-severity" class="form-label">嚴重度</label>
                            <select class="form-select" id="rule-severity">
                                <option value="High">高</option>
                                <option value="Medium">中</option>
                                <option value="Low">低</option>
                            </select>
                        </div>

                        <div class="col-md-9">
                            <label for="rule-description" class="form-label">說明 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="rule-description" required />
                        </div>
                        <div class="col-md-3">
                            <label for="rule-threshold" class="form-label">次數門檻</label>
                            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                    data-bs-content="未達門檻降一級。">
                                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                            </button>
                            <input type="number" class="form-control" id="rule-threshold" min="1" value="1" />
                        </div>
                        <div class="col-md-9 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rule-elevates-day-risk" />
                                <label class="form-check-label" for="rule-elevates-day-risk">
                                    命中即列為高風險日（重大）
                                </label>
                                <div class="form-text">
                                    這條規則命中（且未被抑制）時，當天直接判定為高風險日——原「嚴重」等級的實際作用，
                                    畫面上會標「重大」徽章。
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-1" />
                            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2"
                                    data-bs-toggle="collapse" data-bs-target="#rule-kb" aria-expanded="false" aria-controls="rule-kb">
                                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#chevron-down"></use></svg>
                                處置知識庫
                                <span class="text-muted small" id="rule-kb-summary"></span>
                            </button>
                            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                    data-bs-content="規則命中時直接渲染這裡的內容，不呼叫 AI——更快、更一致、零幻覺。（選填）">
                                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                            </button>
                        </div>

                        <div class="col-12 collapse" id="rule-kb">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label for="rule-plain" class="form-label">白話說明</label>
                                    <textarea class="form-control" id="rule-plain" rows="2"></textarea>
                                </div>
                                <div class="col-12">
                                    <label for="rule-impact" class="form-label">不處理的影響</label>
                                    <textarea class="form-control" id="rule-impact" rows="2"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="rule-causes" class="form-label">常見原因（一行一項）</label>
                                    <textarea class="form-control" id="rule-causes" rows="4"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label for="rule-steps" class="form-label">處置步驟（一行一項）</label>
                                    <textarea class="form-control" id="rule-steps" rows="4"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rule-enabled" checked />
                                <label class="form-check-label" for="rule-enabled">啟用</label>
                                <div class="form-text">
                                    停用只關掉這條規則命中的分類與知識庫顯示，趨勢層／關聯層對同一事件的偵測不受影響——
                                    不是把這個事件從分析中整個拿掉。
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-outline-primary" id="rule-validate">先驗證</button>
                    <button type="submit" class="btn btn-primary" id="rule-save">儲存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 回復預設的前後對照 -->
<div class="modal fade" id="restore-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">回復為程式內建預設</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body" id="restore-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning" id="restore-confirm">回復預設</button>
            </div>
        </div>
    </div>
</div>

<!-- 新增抑制 -->
<div class="modal fade" id="suppress-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">抑制此規則的告警</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="suppress-form">
                <div class="modal-body">
                    <div class="lf-hint mb-3">
                        <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#info-circle"></use></svg>
                        <span>抑制只關掉通知與風險升級，事件仍照常聚合與紀錄。</span>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-title="抑制的作用範圍"
                                data-bs-content="抑制只關掉通知與風險升級，事件仍照常聚合、命中規則、寫入歷史——這樣體檢報告與頻率報表才看得到「這條被抑制的規則本期實際發生了幾次」，暫時關掉的東西不會變成沒人記得的永久盲區。">
                            <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                        </button>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="suppress-scope" class="form-label">範圍 <span class="text-danger">*</span></label>
                            <select class="form-select" id="suppress-scope">
                                <option value="Host">單一主機</option>
                                <option value="Group">主機群組</option>
                                <option value="Site">全站</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <div id="suppress-host-wrap">
                                <label for="suppress-host" class="form-label">主機 <span class="text-danger">*</span></label>
                                <select class="form-select" id="suppress-host">
                                    <option value="">請選擇主機…</option>
                                </select>
                            </div>
                            <div id="suppress-group-wrap" class="d-none">
                                <label for="suppress-group" class="form-label">主機群組 <span class="text-danger">*</span></label>
                                <select class="form-select" id="suppress-group">
                                    <option value="">請選擇主機群組…</option>
                                </select>
                            </div>
                            <div id="suppress-site-wrap" class="d-none">
                                <span class="form-label d-block invisible">範圍</span>
                                <div class="form-text mb-0 mt-1">套用到全站所有主機，不限特定主機或群組。</div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="suppress-days" class="form-label">生效天數</label>
                            <input type="number" class="form-control" id="suppress-days" min="1" placeholder="留空 = 永久，直到手動解除" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="suppress-reason" class="form-label">原因 <span class="text-danger">*</span></label>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-content="日後回頭確認「當初為什麼關掉」的唯一依據。">
                            <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                        </button>
                        <textarea class="form-control" id="suppress-reason" rows="2" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">建立抑制</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rule-import-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">內建規則升級預覽</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="rule-import-overwrite" />
                    <label class="form-check-label" for="rule-import-overwrite">
                        連同已修改的內建規則一併覆蓋（保留原本的啟用/停用設定）
                    </label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="預設只補上缺少的內建規則；若某條 builtin 規則的內容被你改過（且與新版種子不同），需要勾選這個才會覆蓋回種子最新內容。custom 規則永遠不受影響。">
                        <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                    </button>
                </div>
                <div class="mb-3" id="rule-import-summary"></div>
                <div id="rule-import-items"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="rule-import-apply-btn">套用</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/rules.js" asp-append-version="true"></script>
}
