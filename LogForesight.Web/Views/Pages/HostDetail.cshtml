@{
    ViewData["Title"] = "主機詳情";
}

<div id="host-detail" data-host-id="@ViewData["HostId"]">
    <div id="host-header"></div>

    <div class="modal fade" id="host-update-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">指定主機更新</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <form id="host-update-form" novalidate>
                    <div class="modal-body">
                        <p class="mb-3" id="host-update-message"></p>
                        <label for="host-update-backfill" class="form-label">回望天數（選填）</label>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-content="往回檢查幾天內有沒有缺漏或需要補跑的日子（上限 30 天），已完成的日子不會重跑。只影響這次執行，不會落地變更設定值；留空則沿用 NetIQ 維護頁設定的回望天數（本機主機不受此影響）。">
                            <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                        </button>
                        <input type="number" class="form-control form-control-sm" id="host-update-backfill" min="1" max="30" style="max-width: 120px;" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary" id="host-update-submit">開始更新</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <section class="lf-card mt-3">
        <div class="lf-card__header">
            <h2 class="lf-card__title">風險時間軸</h2>
            <div class="btn-group btn-group-sm lf-no-print">
                <button type="button" class="btn btn-outline-primary" data-days="14">14 天</button>
                <button type="button" class="btn btn-outline-primary active" data-days="30">30 天</button>
                <button type="button" class="btn btn-outline-primary" data-days="90">90 天</button>
            </div>
        </div>
        <div class="lf-card__body">
            <div id="host-timeline"></div>
            <div class="d-flex gap-3 mt-3 small text-muted flex-wrap" id="timeline-legend"></div>
        </div>
    </section>

    <section class="lf-card mt-3">
        <div class="lf-card__header">
            <h2 class="lf-card__title">重點問題（期間彙總）</h2>
            <span class="text-muted small">依來源／Event 分組，點列前往最近一次出現的當日詳情</span>
        </div>
        <div class="lf-card__body p-0" id="host-issues"></div>
    </section>

    <section class="lf-card mt-3 d-none" id="checkup-card">
        <div class="lf-card__header">
            <h2 class="lf-card__title">最近一次體檢</h2>
        </div>
        <div class="lf-card__body" id="host-checkup"></div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/host-detail.js" asp-append-version="true"></script>
}
