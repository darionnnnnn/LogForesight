                    <div class="col-12"><label class="form-label" for="prtg-acceptance-outcome">影響結果</label><select id="prtg-acceptance-outcome" class="form-select"><option value="occurred">已實際發生</option><option value="prevented">介入後避免影響（需前後量測）</option><option value="unknown">尚未觀察到結果</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-predicted">預測影響時間（與實際發生分開）</label><input id="prtg-acceptance-predicted" class="form-control" type="datetime-local" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-action">具體介入動作</label><input id="prtg-acceptance-action" class="form-control" maxlength="1000" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-before">介入前量測（含時間、資源與單位）</label><input id="prtg-acceptance-before" class="form-control" maxlength="1000" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-after">介入後量測（含時間、資源與單位）</label><input id="prtg-acceptance-after" class="form-control" maxlength="1000" /></div>
                    <div class="col-12"><label class="form-label" for="prtg-acceptance-result">查證結果</label><select id="prtg-acceptance-result" class="form-select"><option value="">待查證</option><option value="true">確實需要處理</option><option value="false">誤報</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-netiq">NetIQ 可行動時間</label><input id="prtg-acceptance-netiq" class="form-control" type="datetime-local" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-native">原生 PRTG 可行動時間</label><input id="prtg-acceptance-native" class="form-control" type="datetime-local" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="prtg-acceptance-union">簡單聯集可行動時間</label><input id="prtg-acceptance-union" class="form-control" type="datetime-local" /></div>
