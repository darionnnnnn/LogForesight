@{
    ViewData["Title"] = "PRTG 維護";
}

<section class="lf-card mb-3" aria-labelledby="prtg-setup-title">
    <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-setup-title">啟用準備</h2></div>
    <div class="lf-card__body">
        <p class="small text-muted mb-2">依已儲存設定與最近一次檢查結果顯示；設定齊全不代表站台資料完整或預警已驗證。</p>
        <div id="prtg-setup-summary" role="status" aria-live="polite">正在確認 PRTG 啟用狀態…</div>
        <ul id="prtg-setup-steps" class="small mb-0 mt-2"></ul>
    </div>
</section>
<div id="prtg-rule-banner"></div>
<div id="prtg-schedule-banner"></div>
<section class="lf-card mb-3" aria-labelledby="prtg-monitoring-title">
    <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-monitoring-title">正式判定試點與來源身分</h2></div>
    <div class="lf-card__body">
        <p class="small text-muted">先同步結構與主機對應，再選取 NetIQ 主機與 sensor。未確認範圍只保存診斷資料。Core System ID 請由 PRTG 管理介面核對；換 Core 或 sensor 重建後需重新暖機，今日身分不追認歷史。</p>
        <form id="prtg-monitoring-form">
            <label class="form-label" for="prtg-monitoring-core">Core System ID</label>
            <input class="form-control mb-2" id="prtg-monitoring-core" maxlength="128" required />
            <label class="form-label" for="prtg-monitoring-source-mode">來源變更處理</label>
            <select class="form-select mb-2" id="prtg-monitoring-source-mode">
                <option value="">來源未變更（只修改試點）</option>
                <option value="new">新來源／重新暖機</option>
                <option value="continue">同 Core 延續（須有核對證據）</option>
                <option value="unknown">無法確認（停止正式判定）</option>
            </select>
            <label class="form-label" for="prtg-monitoring-continuity-evidence">延續的來源身分核對證據</label>
            <input class="form-control mb-2" id="prtg-monitoring-continuity-evidence" maxlength="1000" placeholder="核對紀錄／工單位置；勿填帳密或 token" />
            <label class="form-check"><input type="checkbox" class="form-check-input" id="prtg-monitoring-continuity-confirm" />我已核對變更前後為同 Core，來源時區、語系及資源身分保持一致。</label>
            <button type="button" class="btn btn-outline-secondary my-2" id="prtg-monitoring-source-preview">預覽來源變更影響</button>
            <div id="prtg-monitoring-source-impact" role="status" aria-live="polite"></div>
            <label class="form-label" for="prtg-monitoring-zone">PRTG 回應時間的時區</label>
            <input class="form-control mb-2" id="prtg-monitoring-zone" maxlength="128" placeholder="例如 Taipei Standard Time 或 Asia/Taipei" required />
            <label class="form-label" for="prtg-monitoring-culture">PRTG 回應日期的語系</label>
            <input class="form-control mb-2" id="prtg-monitoring-culture" maxlength="64" placeholder="例如 zh-TW、en-US" required />
            <p class="small text-muted">需與 API 帳號看到的日期、時區一致；不以網頁使用者或 Web 伺服器語系猜測。更改後開始新暖機。</p>
            <label class="form-label" for="prtg-monitoring-host-search">搜尋 NetIQ 試點主機（勾選狀態會跨頁保留）</label>
            <p class="small text-muted" id="prtg-monitoring-selection-limits">正式作用範圍最多選取 3,000 台主機與 15,000 顆 sensor。目錄可分頁瀏覽較大環境；超過選取上限會明確拒絕，不會截斷選取或保存部分範圍。</p>
            <input class="form-control mb-2" id="prtg-monitoring-host-search" maxlength="128" autocomplete="off" />
            <div class="d-flex align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-host-prev" type="button">上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-host-next" type="button">下一頁</button>
                <span class="small text-muted" id="prtg-monitoring-host-page-info"></span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-primary" id="prtg-monitoring-host-select-page" type="button">勾選本頁主機</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-host-clear-page" type="button">取消本頁主機</button>
                <button class="btn btn-sm btn-outline-primary" id="prtg-monitoring-host-select-search" type="button">加入目前主機搜尋結果</button>
                <button class="btn btn-sm btn-outline-danger d-none" id="prtg-monitoring-host-select-cancel" type="button">停止批次</button>
                <span class="small text-muted" id="prtg-monitoring-host-batch-status" role="status" aria-live="polite"></span>
            </div>
            <div id="prtg-monitoring-hosts" class="border rounded p-2 mb-2" style="max-height:14rem;overflow:auto" aria-label="試點主機"></div>
            <div class="small text-muted mb-1">已保存主機（包含停用、合併或已移除的舊項目）；只載入每頁 100 筆。移除舊項目不會自動移除 sensor，請在下方另行核對。</div>
            <label class="form-label" for="prtg-monitoring-saved-host-search">搜尋已保存主機</label>
            <input class="form-control mb-2" id="prtg-monitoring-saved-host-search" maxlength="128" autocomplete="off" />
            <div class="d-flex align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-saved-host-prev" type="button">上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-saved-host-next" type="button">下一頁</button>
                <span class="small text-muted" id="prtg-monitoring-saved-host-page-info"></span>
            </div>
            <div id="prtg-monitoring-saved-hosts" class="border rounded p-2 mb-3" style="max-height:14rem;overflow:auto" aria-label="已保存主機管理"></div>
            <label class="form-label" for="prtg-monitoring-sensor-search">搜尋所選主機的 sensor（最多 100 筆／頁）</label>
            <input class="form-control mb-2" id="prtg-monitoring-sensor-search" maxlength="128" autocomplete="off" />
            <div class="d-flex align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-sensor-prev" type="button">上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-sensor-next" type="button">下一頁</button>
                <span class="small text-muted" id="prtg-monitoring-sensor-page-info"></span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-primary" id="prtg-monitoring-sensor-select-page" type="button">勾選本頁 sensor</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-sensor-clear-page" type="button">取消本頁 sensor</button>
                <button class="btn btn-sm btn-outline-primary" id="prtg-monitoring-sensor-select-search" type="button">加入目前 sensor 搜尋結果</button>
                <button class="btn btn-sm btn-outline-danger d-none" id="prtg-monitoring-sensor-select-cancel" type="button">停止批次</button>
                <span class="small text-muted" id="prtg-monitoring-sensor-batch-status" role="status" aria-live="polite"></span>
            </div>
            <div id="prtg-monitoring-sensors" class="border rounded p-2 mb-2" style="max-height:18rem;overflow:auto" aria-label="試點感測器"></div>
            <div class="small text-muted mb-2">已選 sensor（包含目前篩選之外及已不在目錄中的 ID）；可搜尋並逐頁移除，每頁最多顯示 100 筆。</div>
            <label class="form-label" for="prtg-monitoring-selected-sensor-search">搜尋已選 sensor ID</label>
            <input class="form-control mb-2" id="prtg-monitoring-selected-sensor-search" maxlength="32" inputmode="numeric" autocomplete="off" />
            <div class="d-flex align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-selected-sensor-prev" type="button">上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-monitoring-selected-sensor-next" type="button">下一頁</button>
                <span class="small text-muted" id="prtg-monitoring-selected-sensor-page-info"></span>
            </div>
            <div id="prtg-monitoring-selected-sensors" class="d-flex flex-wrap gap-1 mb-2" aria-label="已選 sensor"></div>
            <button class="btn btn-outline-primary mt-2" id="prtg-monitoring-estimate" type="button">估算所選範圍與容量</button>
            <div id="prtg-monitoring-estimate-result" class="small mt-2" role="status" aria-live="polite"></div>
            <label class="form-check"><input type="checkbox" class="form-check-input" id="prtg-monitoring-confirm" required />我已核對 Core 身分與所選資源；守門資源不因取數而自動參與業務判定。</label>
            <button class="btn btn-primary mt-2" type="submit" disabled>儲存正式判定範圍</button>
        </form>
        <div id="prtg-monitoring-status" class="small mt-2" role="status" aria-live="polite"></div>
        <button type="button" class="btn btn-outline-secondary mt-2" id="prtg-monitoring-preview">預覽已儲存試點的實際作用範圍</button>
        <div id="prtg-monitoring-preview-result" class="small mt-2" role="status" aria-live="polite"></div>
    </div>
</section>

<section class="lf-card mb-3" aria-labelledby="prtg-operations-title">
    <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-operations-title">補追加與通知處理狀態</h2></div>
    <div class="lf-card__body">
        <p class="small text-muted">只顯示可見主機。等待 NetIQ 的證據不建立正式問題；SMTP 接受不代表信箱實收。重試部分成功郵件可能重寄。</p>
        <button type="button" class="btn btn-outline-secondary" id="prtg-operations-refresh">重新查詢</button>
        <button type="button" class="btn btn-outline-primary" id="prtg-operations-retry">重試未完成工作</button>
        <div id="prtg-operations-status" class="small mt-2" role="status" aria-live="polite"></div>
    </div>
</section>

<ul class="nav nav-tabs mb-3" id="prtg-tabs">
    <li class="nav-item"><button class="nav-link active" data-tab="connection" type="button">連線</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="params" type="button">擷取參數</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="mirror" type="button">鏡像狀態</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="probe" type="button">環境探測</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="selected-backfill" type="button">指定主機補值</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="timeline-progress" type="button">狀態涵蓋進度</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="profile-refresh" type="button">Trusted profile 進度</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="effectiveness" type="button">使用效果</button></li>
    <li class="nav-item ms-sm-auto"><button class="nav-link small" data-tab="probe" type="button">前往探測與資料準備度</button></li>
</ul>

<div data-panel="timeline-progress" class="d-none">
    <section class="lf-card mb-3" aria-labelledby="prtg-timeline-progress-title">
        <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-timeline-progress-title">逐 sensor 狀態涵蓋進度</h2></div>
        <div class="lf-card__body">
            <p class="small text-muted">背景工作以有限週期補抓目前來源與選取範圍。首次週期預設72小時；期限到達會停止新請求，需管理者明確續行。週期完成只表示所有選取 sensor 的初始查詢已封閉且目前身分相符；歷史涵蓋欄位與各規則自己的品質、暖機條件另行判定。成本數字是估算，不是容量或服務水準保證。</p>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label class="small" for="prtg-timeline-bootstrap-hours">期限（小時）</label>
                <input type="number" class="form-control form-control-sm" id="prtg-timeline-bootstrap-hours" min="1" max="720" value="72" style="width:6rem">
                <button type="button" class="btn btn-sm btn-outline-primary" id="prtg-timeline-bootstrap-save">保存期限</button>
                <button type="button" class="btn btn-sm btn-outline-warning" id="prtg-timeline-bootstrap-resume" disabled>明確續行逾期週期</button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="prtg-timeline-progress-refresh">重新載入</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-timeline-progress-cancel" disabled>取消本次查詢</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-timeline-progress-prev" disabled>上一頁</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-timeline-progress-next" disabled>下一頁</button>
                <span id="prtg-timeline-progress-page" class="small text-muted"></span>
            </div>
            <div id="prtg-timeline-progress-status" class="small mb-2" role="status" aria-live="polite">選取此頁籤後載入進度。</div>
            <div id="prtg-timeline-progress-rows" class="border rounded p-2" aria-live="polite"></div>
        </div>
    </section>
</div>

<div data-panel="profile-refresh" class="d-none">
    <section class="lf-card mb-3" aria-labelledby="prtg-profile-refresh-title">
        <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-profile-refresh-title">Trusted sampling profile 更新進度</h2></div>
        <div class="lf-card__body">
            <p class="small text-muted">背景工作公平巡覽目前正式選取的 sensor，每次最多讀取 100 筆並探測最多 5 顆。只有目前啟用、CPU／記憶體／磁碟且未暫停的資源會探測；來源欄位或身分未能證明時會等待並冷卻重試。這項進度不代表 15,000 顆容量驗收或原生 PRTG 24 小時歷史證明。</p>
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button class="btn btn-sm btn-outline-primary" id="prtg-profile-refresh-reload" type="button">重新載入</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-refresh-prev" type="button" disabled>上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-refresh-next" type="button" disabled>下一頁</button>
                <span id="prtg-profile-refresh-page" class="small text-muted align-self-center"></span>
            </div>
            <div id="prtg-profile-refresh-progress" class="small mb-2" role="status" aria-live="polite">選取此頁籤後載入進度。</div>
            <div id="prtg-profile-refresh-rows" class="border rounded p-2" aria-live="polite"></div>
            <hr />
            <h3 class="h6">逐 sensor 頻道綁定與資格</h3>
            <p class="small text-muted">每列依明確 Sensor ID 載入設定。先執行最多 5 顆的唯讀來源 probe，再由管理者逐一選擇精確 Channel ID；不預選第一個頻道。首次或語意變更保存為 waiting；完全相同且仍有效的保存保留既有資格。正式資格需要「核驗此綁定」的真實來源證據。</p>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-binding-prev" type="button" disabled>上一頁</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-binding-next" type="button" disabled>下一頁</button>
                <span id="prtg-profile-binding-page" class="small text-muted"></span>
            </div>
            <div id="prtg-profile-binding-status" class="small mb-2" role="status" aria-live="polite">正在載入已選 sensor 的 profile…</div>
            <div id="prtg-profile-binding-rows" class="border rounded p-2 mb-3" aria-live="polite"></div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span id="prtg-profile-binding-batch-status" class="small" role="status" aria-live="polite">尚無批次草稿。</span>
                <button class="btn btn-sm btn-outline-primary" id="prtg-profile-binding-batch-submit" type="button" disabled>提交批次綁定（最多 100 筆）</button>
                <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-binding-batch-clear" type="button" disabled>清除批次草稿</button>
            </div>
            <div id="prtg-profile-binding-batch-results" class="small mb-3" aria-live="polite"></div>
            <form id="prtg-profile-binding-form" class="border rounded p-3 d-none">
                <h4 class="h6">目前 sensor <span id="prtg-profile-binding-sensor-label"></span></h4>
                <div id="prtg-profile-binding-current" class="small mb-2" role="status" aria-live="polite"></div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-primary" id="prtg-profile-binding-probe" type="button">讀取可選來源頻道</button>
                    <button class="btn btn-sm btn-outline-secondary" id="prtg-profile-binding-reload" type="button">重新載入目前版本</button>
                </div>
                <label class="form-label" for="prtg-profile-binding-channel">來源 probe 回傳的精確 Channel ID</label>
                <select class="form-select mb-2" id="prtg-profile-binding-channel" required><option value="">請先 probe 並人工選取頻道</option></select>
                <div id="prtg-profile-binding-channel-evidence" class="small text-muted mb-2" aria-live="polite"></div>
                <div class="row g-2">
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-quantity">語意</label><select class="form-select" id="prtg-profile-binding-quantity" required><option value="">請選擇</option><option value="1">CPU</option><option value="2">MemoryUsed</option><option value="3">MemoryAvailable</option><option value="4">DiskFree</option><option value="5">DiskUsed</option></select></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-unit">單位</label><input class="form-control" id="prtg-profile-binding-unit" value="%" readonly required aria-describedby="prtg-profile-binding-unit-note" /><div id="prtg-profile-binding-unit-note" class="form-text">此版本只接受百分比單位。</div></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-scale">Scale</label><input class="form-control" id="prtg-profile-binding-scale" type="number" min="0.000000001" step="any" value="1" required /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-direction">方向</label><select class="form-select" id="prtg-profile-binding-direction" required><option value="">請選擇</option><option value="direct">direct</option><option value="inverse">inverse</option><option value="absolute">absolute</option></select></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-interval-unit">原始間隔單位</label><select class="form-select" id="prtg-profile-binding-interval-unit" required><option value="">請選擇</option><option value="seconds">seconds</option><option value="minutes">minutes</option></select></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-raw-zone">原始時間時區</label><input class="form-control" id="prtg-profile-binding-raw-zone" maxlength="128" required /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="prtg-profile-binding-analysis-zone">分析時區</label><input class="form-control" id="prtg-profile-binding-analysis-zone" maxlength="128" required /></div>
                    <div class="col-12"><label class="form-label" for="prtg-profile-binding-time-evidence">時基證據 opaque 參考（不含 URL 或密鑰）</label><input class="form-control" id="prtg-profile-binding-time-evidence" maxlength="128" required /><div class="form-text">只填不透明證據參考，最多 128 字元；不可貼 URL、連線資訊或密鑰。</div></div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-outline-primary" id="prtg-profile-binding-save" type="submit">保存綁定（等待核驗）</button>
                    <button class="btn btn-outline-secondary" id="prtg-profile-binding-queue" type="button">加入批次草稿</button>
                    <button class="btn btn-primary" id="prtg-profile-binding-qualify" type="button" disabled>核驗此綁定</button>
                </div>
                <div id="prtg-profile-binding-action-status" class="small mt-2" role="status" aria-live="polite"></div>
            </form>
        </div>
    </section>
    @await Html.PartialAsync("_PrtgQualificationJobs")
</div>

<div data-panel="effectiveness" class="d-none">
    <section class="lf-card mb-4" id="prtg-effectiveness" aria-labelledby="prtg-effectiveness-title">
        <div class="lf-card__header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 class="lf-card__title" id="prtg-effectiveness-title">PRTG 使用效果</h2>
        </div>
        <div class="lf-card__body">
            <p class="small text-muted">依所選日期統計既有資料。各項數字的計算對象不同，彼此不構成轉換流程；「—」代表資料不足以計算，不代表 0。</p>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-sm-5 col-md-4"><label class="form-label" for="prtg-effectiveness-from">起始日期</label><input class="form-control" type="date" id="prtg-effectiveness-from" /></div>
                <div class="col-12 col-sm-5 col-md-4"><label class="form-label" for="prtg-effectiveness-through">結束日期</label><input class="form-control" type="date" id="prtg-effectiveness-through" /></div>
                    <div class="col-12 col-sm-auto"><button type="button" class="btn btn-primary" id="prtg-effectiveness-refresh">查詢</button></div>
