@{
    ViewData["Title"] = "PRTG 維護";
}

<div id="prtg-rule-banner"></div>
<div id="prtg-schedule-banner"></div>

<ul class="nav nav-tabs mb-3" id="prtg-tabs">
    <li class="nav-item"><button class="nav-link active" data-tab="connection" type="button">連線</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="params" type="button">擷取參數</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="mirror" type="button">鏡像狀態</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="probe" type="button">環境探測</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="selected-backfill" type="button">指定主機補值</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="effectiveness" type="button">使用效果</button></li>
    <li class="nav-item ms-sm-auto"><button class="nav-link small" data-tab="probe" type="button">前往探測與資料準備度</button></li>
</ul>

<div data-panel="effectiveness" class="d-none">
    <section class="lf-card mb-4" id="prtg-effectiveness" aria-labelledby="prtg-effectiveness-title">
        <div class="lf-card__header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 class="lf-card__title" id="prtg-effectiveness-title">PRTG 使用效果</h2>
        </div>
        <div class="lf-card__body">
            <p class="small text-muted">依所選日期統計既有資料。各項數字的計算對象不同，彼此不構成轉換流程；「—」代表資料不足以計算，不代表 0。</p>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-sm-5 col-md-4"><label class="form-label" for="prtg-effectiveness-from">起始日期</label><input class="form-control" type="date" id="prtg-effectiveness-from" /></div>
                <div class="col-12 col-sm-5 col-md-4"><label class="form-label" for="prtg-effectiveness-through">結束日期</label><input class="form-control" type="date" id="prtg-effectiveness-through" /></div>
                    <div class="col-12 col-sm-auto"><button type="button" class="btn btn-primary" id="prtg-effectiveness-refresh">查詢</button></div>
            </div>
            <div id="prtg-effectiveness-status" class="small mb-3" role="status" aria-live="polite" aria-atomic="true">選擇日期後按「查詢」載入資料。</div>
            <div id="prtg-effectiveness-error" class="mb-3" aria-live="polite"></div>
            <div id="prtg-effectiveness-metrics" class="row g-2 d-none" aria-label="使用效果指標"></div>
            <details class="small mt-3" id="prtg-effectiveness-details">
                <summary>指標定義與限制</summary>
                <p class="mt-2 mb-1" id="prtg-effectiveness-semantics"></p>
                <p class="mb-0 text-muted" id="prtg-effectiveness-limitations"></p>
            </details>
        </div>
    </section>
</div>

<div data-panel="selected-backfill" class="d-none">
    <section class="lf-card" aria-labelledby="prtg-selected-backfill-title">
        <div class="lf-card__header"><h2 class="lf-card__title" id="prtg-selected-backfill-title">指定主機歷史數值補值</h2></div>
        <div class="lf-card__body">
            <p class="small text-muted">只補指定主機與日期的 PRTG 歷史數值，不會重跑歷史 finding 評估，也不會建立或派送案件／交辦。最多選 5 台主機、最多 7 天。</p>
            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-6">
                    <label for="prtg-selected-backfill-search" class="form-label">搜尋已儲存主機</label>
                    <input id="prtg-selected-backfill-search" class="form-control" type="search" autocomplete="off" aria-controls="prtg-selected-backfill-hosts" placeholder="輸入主機名稱或 IP" />
                    <div class="form-text" id="prtg-selected-backfill-host-help">使用方向鍵、空白鍵或滑鼠選取，最多 5 台。</div>
                    <div id="prtg-selected-backfill-hosts" class="border rounded mt-2 p-2" role="group" aria-describedby="prtg-selected-backfill-host-help" style="max-height: 16rem; overflow-y: auto;">
                        <span class="small text-muted">載入主機清單中…</span>
                    </div>
                    <div class="small mt-1" id="prtg-selected-backfill-selection" aria-live="polite"></div>
                </div>
                <div class="col-12 col-lg-6"><div class="row g-3">
                    <div class="col-12 col-sm-6"><label for="prtg-selected-backfill-from" class="form-label">起始日期</label><input id="prtg-selected-backfill-from" class="form-control" type="date" /></div>
                    <div class="col-12 col-sm-6"><label for="prtg-selected-backfill-to" class="form-label">結束日期</label><input id="prtg-selected-backfill-to" class="form-control" type="date" /></div>
                </div><div class="form-text mt-2">含起訖日；日期需在 PRTG 歷史保留範圍內。</div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-outline-primary" id="prtg-selected-backfill-preview">預覽工作量</button><button type="button" class="btn btn-primary" id="prtg-selected-backfill-start" disabled>確認並開始補值</button></div>
            <div id="prtg-selected-backfill-preview-result" aria-live="polite" aria-atomic="true"></div>
            <div class="border rounded p-3 mt-3" id="prtg-selected-backfill-status" aria-live="polite"><div class="d-flex flex-wrap align-items-center gap-2"><span id="prtg-selected-backfill-status-text">讀取回填狀態中…</span><button type="button" class="btn btn-sm btn-outline-danger d-none" id="prtg-selected-backfill-cancel">停止回填</button><button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-selected-backfill-status-retry">重新整理狀態</button></div><div class="small text-muted mt-1" id="prtg-selected-backfill-progress"></div></div>
        </div>
    </section>
</div>

<div data-panel="connection">
    <form id="prtg-connection-form">
        <div class="lf-card">
            <div class="lf-card__header">
                <h2 class="lf-card__title">連線</h2>
            </div>
            <div class="lf-card__body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="prtg-url" class="form-label">PRTG 位址</label>
                        <input type="text" class="form-control" id="prtg-url" placeholder="https://prtg.example.local" />
                    </div>
                    <div class="col-md-6">
                        <label for="prtg-auth-mode" class="form-label">認證方式</label>
                        <select class="form-select" id="prtg-auth-mode">
                            <option value="token">API token（推薦，PRTG 21+）</option>
                            <option value="password">帳號密碼（PRTG 傳統 API / passhash）</option>
                            <option value="passhash">帳號＋passhash</option>
                        </select>
                        <div class="form-text">PRTG 21.x 之後版本建議使用 API token；舊版 PRTG 或特定環境可切換為帳號密碼。</div>
                    </div>
                </div>

                <div id="prtg-auth-username-field" class="d-none">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="prtg-username" class="form-label">使用者帳號</label>
                            <input type="text" class="form-control" id="prtg-username" placeholder="prtgadmin" />
                            <div class="form-text">具備讀取權限的 PRTG 登入帳號。</div>
                        </div>
                    </div>
                </div>

                <div id="prtg-auth-token-fields">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="prtg-api-token" class="form-label">API token</label>
                            <input type="password" class="form-control" id="prtg-api-token" autocomplete="new-password" placeholder="留空＝沿用既有 API token" />
                            <div class="form-text" id="prtg-api-token-hint"></div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="prtg-clear-token" />
                                <label class="form-check-label" for="prtg-clear-token">清除目前的 API token</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="prtg-auth-password-fields" class="d-none">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="prtg-password" class="form-label">密碼</label>
                            <input type="password" class="form-control" id="prtg-password" autocomplete="new-password" placeholder="留空＝沿用既有密碼" />
                            <div class="form-text" id="prtg-password-hint"></div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="prtg-clear-password" />
                                <label class="form-check-label" for="prtg-clear-password">清除目前的密碼</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="prtg-auth-passhash-fields" class="d-none">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="prtg-passhash" class="form-label">PRTG passhash</label>
                            <input type="password" class="form-control" id="prtg-passhash" autocomplete="new-password" placeholder="留空＝沿用既有 passhash" />
                            <div class="form-text" id="prtg-passhash-hint"></div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="prtg-clear-passhash" />
                                <label class="form-check-label" for="prtg-clear-passhash">清除目前的 passhash</label>
                            </div>
                            <div class="form-text">
                                passhash 可在 PRTG 的使用者帳號設定頁取得（Show passhash），或自行呼叫 /api/getpasshash.htm 換取。LogForesight 不會保存密碼、也不會替你換取 passhash。
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="mb-3">
                    <h3 class="h6">測試連線</h3>
                    <p class="text-muted small">
                        用上方表單目前填的值試連線（尚未儲存也可以測）；token 或密碼欄留空時沿用已儲存的值。
                    </p>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="prtg-test-btn">測試連線</button>
                    </div>
                    <div id="prtg-test-result"></div>
                </div>

                <div class="d-flex align-items-center gap-3 mt-3">
                    <button type="submit" class="btn btn-primary" id="prtg-connection-save">儲存</button>
                    <span class="text-muted small" id="prtg-config-updated"></span>
                </div>
            </div>
        </div>
    </form>
</div>

<div data-panel="params" class="d-none">
    <form id="prtg-params-form">
        <div class="lf-card">
            <div class="lf-card__header">
                <h2 class="lf-card__title">擷取參數</h2>
            </div>
            <div class="lf-card__body">
                <div class="mb-3">
                    <label for="prtg-fetch-strategy" class="form-label fw-semibold">取數策略</label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="保守：每 15 分鐘對 PRTG 查一次快照目標感測器的目前值（一天約 96 次，每 50 顆一個請求、依序送出，同時只有 1 個請求），夜間不逐顆查詢，數值全由快照供應。激進：每 5 分鐘一次（一天約 288 次），另在夜間對觸發主機逐顆查詢歷史值（每晚數百次、單次 5～70 秒），PRTG 負擔明顯較高。實際的快照目標感測器數與每日寫入列數，請按下方「估算規模」查看。兩種策略下快照連續失敗 3 次都會自動拉長間隔（上限 60 分鐘）。">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                    </button>
                    <select class="form-select" id="prtg-fetch-strategy">
                        <option value="conservative">保守（預設）：每 15 分鐘快照一次，夜間不逐顆查詢</option>
                        <option value="aggressive">激進：每 5 分鐘快照一次，夜間另逐顆查詢觸發主機</option>
                    </select>
                    <div class="form-text">
                        快照是對 PRTG 發一次全量查詢取即時值，由站台自己平均成小時值。
                    </div>
                    <div class="small text-warning mt-2 d-none" id="prtg-strategy-aggressive-hint">
                        激進策略每 5 分鐘對 PRTG 查一次快照目標感測器的目前值（每 50 顆一個請求），並在每晚對觸發主機逐顆查詢歷史值，PRTG 負載明顯較高。請先用保守策略觀察執行輸出裡的快照耗時與失敗數，確認 PRTG 承受得住再切換；切換後若看到快照間隔被自動拉長，代表 PRTG 已經回不來，請切回保守。
                    </div>
                    <div class="small text-info mt-2 d-none" id="prtg-strategy-suggested-hint">已帶入建議設定（併發請求數與逾時秒數），仍可依環境需求修改。</div>
                </div>

                <div class="small text-muted mb-3" id="prtg-strategy-scope-explanation">保守策略：夜間不逐顆查詢歷史值，數值由每 15 分鐘的快照供應（快照涵蓋全部監看裝置），數值取數對象不適用。激進策略：夜間依數值取數對象逐顆查詢。</div>

                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <label for="prtg-value-fetch-scope" class="form-label fw-semibold mb-0">PRTG 擷取（數值取數對象）</label>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-content="選擇任一數值取數對象即啟用 PRTG 擷取。數值取數對象只決定夜間要抓哪些主機的數值；感測器與狀態變更同步的是「監看裝置」（由主機對應算出的裝置集合），兩者不同。預設只抓當日出問題的主機（高／中風險或 PRTG 規則命中）——實機環境 sensor 數以萬計，全抓一晚跑不完，對從沒出過問題的主機取數也沒有分析價值。要為值型規則累積基線時才放寬。">
                            <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                        </button>
                        <span class="small text-muted d-none" id="prtg-scope-inapplicable-hint">保守策略下不適用</span>
                    </div>
                    <select class="form-select mt-2" id="prtg-value-fetch-scope">
                        <option value="off">關閉（預設）</option>
                        <option value="triggered">只抓觸發主機</option>
                        <option value="all-mapped">全部已對應主機</option>
                        <option value="triggered-plus-list">觸發主機＋指定清單</option>
                    </select>
                    <div class="form-text">
                        選擇任一數值取數對象即啟用 PRTG 擷取；關閉時夜間擷取、歷史回填與結構同步都不執行，
                        環境探測與資源守門預覽不受影響。
                        「全部已對應主機」要求 sensor type 白名單非空——留空等於對全部 sensor 取數。
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="prtg-ignore-ssl" />
                            <label class="form-check-label" for="prtg-ignore-ssl">忽略憑證錯誤</label>
                            <div class="form-text">僅在 PRTG 使用自簽憑證的內網環境啟用。</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="prtg-timeout-seconds" class="form-label">請求逾時（秒）</label>
                        <input type="number" class="form-control" id="prtg-timeout-seconds" min="5" max="600" />
                        <div class="form-text">historicdata 單次實測最長超過 100 秒，激進策略或執行歷史回填時建議設 120 以上。</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="prtg-fetch-concurrency" class="form-label">併發請求數</label>
                        <input type="number" class="form-control" id="prtg-fetch-concurrency" min="1" max="8" />
                        <div class="form-text">保守策略建議 2、激進策略建議 4；實測併發 8 時 PRTG 端開始排隊，單次延遲可能超過請求逾時。</div>
                    </div>
                    <div class="col-md-4">
                        <label for="prtg-backfill-days" class="form-label">歷史回填天數</label>
                        <input type="number" class="form-control" id="prtg-backfill-days" min="1" max="365" />
                    </div>
                    <div class="col-md-4">
                        <label for="prtg-retention-days" class="form-label">PRTG 資料保留天數</label>
                        <input type="number" class="form-control" id="prtg-retention-days" min="90" max="3650" />
                        <div class="form-text">不得大於歷史資料保留天數。</div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <div class="d-flex align-items-center gap-1">
                            <label for="prtg-sensor-type-whitelist" class="form-label mb-0">擷取數值的 sensor type 白名單</label>
                            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                    data-bs-content="一行一個 PRTG sensor type，不分大小寫。只有白名單內的 type 會擷取數值資料。留空代表不限制（會對全部 sensor 取數，大型環境不建議）。">
                                <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                            </button>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-sensor-whitelist-probe-fill-btn">從環境探測填入</button>
                    </div>
                    <textarea class="form-control lf-mono" id="prtg-sensor-type-whitelist" rows="6"
                              placeholder="SNMP Disk Free&#10;SNMP CPU Load"></textarea>
                    <div class="form-text">探測抽樣僅為估算值，填入後請確認內容再儲存。</div>
                </div>

                <div class="mb-3">
                    <label for="prtg-sensor-type-category-overrides" class="form-label">sensor type 分類補充對照</label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="一行一個『type=分類』，不分大小寫。分類可填 traffic、disk、cpu、memory、availability、hardware。這裡優先於內建對照，下次結構同步後生效，並會重新套用在先前自動分類的 sensor 上。注意：資源守門的自動偵測依 cpu／memory 分類挑 sensor，改動會影響偵測結果。">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                    </button>
                    <textarea class="form-control lf-mono" id="prtg-sensor-type-category-overrides" rows="4"
                              placeholder="SNMP Dell PowerEdge System Health=hardware"></textarea>
                </div>

                <div class="mb-3 d-none" id="prtg-value-fetch-extra-hosts-group">
                    <label for="prtg-value-fetch-extra-hosts" class="form-label">額外納入的主機名稱</label>
                    <textarea class="form-control lf-mono" id="prtg-value-fetch-extra-hosts" rows="4"
                              placeholder="SRV-DB01&#10;SRV-APP02"></textarea>
                    <div class="form-text">一行一個主機名稱，不分大小寫；對不到主機主檔的會在執行輸出列出並略過。</div>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-3 mt-3">
                    <button type="submit" class="btn btn-primary" id="prtg-params-save">儲存</button>
                    <button type="button" class="btn btn-outline-secondary" id="prtg-scope-estimate-btn">估算規模</button>
                    <span id="prtg-scope-estimate-result" class="small"></span>
                    <span class="small d-block" id="prtg-snapshot-estimate-result"></span>
                </div>
            </div>
        </div>

        <div class="alert alert-light border mt-3 mb-0 small" role="note">
            <strong>資源守門</strong>已移到
            <a href="@Url.Content("~/admin/settings")#guard">系統管理 &gt; 設定 &gt; 資源守門</a>。
            守門同時節制 NetIQ 取數與 PRTG 擷取兩路，不只是 PRTG 的事，因此設定與其他全站參數放在一起。
        </div>
    </form>
</div>

<div data-panel="mirror" class="d-none">
    <section class="lf-card mb-3" aria-labelledby="prtg-snapshot-diagnostics-title">
        <div class="lf-card__header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 class="lf-card__title" id="prtg-snapshot-diagnostics-title">快照最近 24 個完整小時</h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="prtg-snapshot-diagnostics-retry">重新載入</button>
        </div>
        <div class="lf-card__body">
