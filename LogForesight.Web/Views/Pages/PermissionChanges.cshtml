@{
    ViewData["Title"] = "權限異動檢核";
}

<div class="lf-hint mb-3">
    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#info-circle"></use></svg>
    <span>系統負責發現異動，請逐筆確認每筆是否為授權操作。</span>
    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
            data-bs-title="為什麼要逐筆確認"
            data-bs-content="自動檢查負責發現有異動，逐筆確認讓了解環境的人判斷這筆是否正常——同一筆 ACL 新增，管理員自己設定的就是正常維運，非預期出現的就是入侵訊號。">
        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
    </button>
</div>

<ul class="nav nav-tabs mb-3" id="perm-tabs">
    <li class="nav-item"><button class="nav-link active" data-status="pending" type="button">待確認</button></li>
    <li class="nav-item"><button class="nav-link" data-status="authorized" type="button">已確認授權</button></li>
    <li class="nav-item"><button class="nav-link" data-status="suspicious" type="button">標記可疑</button></li>
    <li class="nav-item"><button class="nav-link" data-status="" type="button">全部</button></li>
</ul>

<div class="lf-toolbar">
    <form id="filter-form" class="lf-toolbar__row">
        <div class="lf-toolbar__search">
            <input type="search" class="form-control form-control-sm" id="filter-keyword"
                   placeholder="搜尋主機、帳號、對象、說明" autocomplete="off" />
        </div>
        <div class="lf-toolbar__field position-relative" style="min-width: 200px;">
            <input type="text" class="form-control form-control-sm" id="filter-subnet"
                   placeholder="網段，例：192.168.1.0/24" autocomplete="off" />
            <div class="invalid-feedback" id="filter-subnet-feedback"></div>
        </div>
        <div class="lf-toolbar__field" style="min-width: 130px;">
            <select class="form-select form-select-sm" id="filter-source">
                <option value="">全部來源</option>
                <option value="本機監控">本機監控</option>
                <option value="NetIQ 事件">NetIQ 事件</option>
            </select>
        </div>
        <div class="lf-toolbar__field d-flex align-items-center gap-1" style="min-width: 260px;">
            <input type="date" class="form-control form-control-sm" id="filter-from" title="起始時間" />
            <span class="text-muted small">～</span>
            <input type="date" class="form-control form-control-sm" id="filter-to" title="結束時間" />
        </div>
        <div class="lf-toolbar__field">
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" data-range="1">昨日</button>
                <button type="button" class="btn btn-outline-secondary" data-range="7">近 7 天</button>
                <button type="button" class="btn btn-outline-secondary" data-range="30">近 30 天</button>
                <button type="button" class="btn btn-outline-secondary" data-range="90">近 90 天</button>
            </div>
        </div>
        <div class="lf-toolbar__spacer"></div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-reset-filters">清除篩選</button>
        </div>
    </form>
    <div class="lf-toolbar__row d-none" id="filter-category-row">
        <div class="lf-toolbar__group">
            <span class="lf-toolbar__group-label">類別</span>
            <div class="lf-toolbar__chips" id="filter-category-chips"></div>
        </div>
    </div>
</div>

<div class="lf-toolbar mb-3">
    <button type="button" class="btn btn-sm btn-outline-primary" id="btn-select-all-matching">
        全選符合目前篩選的權限異動
    </button>
    <span class="text-muted small">只會選取待確認的項目；已確認的項目不會被選到。</span>
</div>

<div class="lf-toolbar mb-3 d-none" id="perm-selection-bar">
    <span class="fw-semibold" id="perm-selection-count"></span>
    <button type="button" class="btn btn-sm btn-success" id="btn-batch-authorize">標記為授權操作</button>
    <button type="button" class="btn btn-sm btn-danger" id="btn-batch-suspicious">標記為可疑</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-clear-selection">清除選取</button>
</div>

<div class="lf-card">
    <div class="lf-card__header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="lf-card__title mb-0">權限異動 <span class="text-muted small" id="perm-count"></span></h2>
        <div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-toggle-expand">全部展開</button>
        </div>
    </div>
    <div class="lf-card__body p-0" id="perm-list"></div>
</div>

<nav class="mt-3" id="perm-pager"></nav>

<div class="modal fade" id="confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirm-modal-title">確認權限異動</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="confirm-form">
                <div class="modal-body">
                    <div class="mb-3" id="confirm-detail"></div>
                    <div class="mb-2">
                        <label for="confirm-note" class="form-label">說明</label>
                        <textarea class="form-control" id="confirm-note" rows="3"></textarea>
                        <div class="form-text" id="confirm-note-hint"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="confirm-submit">確認</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="batch-confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="batch-confirm-modal-title">批次確認權限異動</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="batch-confirm-form" novalidate>
                <div class="modal-body">
                    <div class="alert alert-info mb-3" id="batch-confirm-summary-text"></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">依類別摘要</label>
                            <div id="batch-confirm-categories" class="border rounded p-2" style="max-height: 180px; overflow-y: auto;"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">依主機摘要</label>
                            <div id="batch-confirm-hosts" class="border rounded p-2" style="max-height: 180px; overflow-y: auto;"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="batch-confirm-note" class="form-label">說明 <span id="batch-confirm-note-required" class="text-danger d-none">*</span></label>
                        <textarea class="form-control" id="batch-confirm-note" rows="3"></textarea>
                        <div class="form-text" id="batch-confirm-note-hint"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="batch-confirm-submit">確認</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="batch-skipped-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">批次處理略過清單</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3" id="batch-skipped-summary"></div>
                <div id="batch-skipped-list" class="lf-bulk-assign-hosts"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">確定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/permission-changes.js" asp-append-version="true"></script>
}
