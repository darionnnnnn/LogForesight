@inject LogForesight.Web.Services.IBrandProvider Brand
@{
    ViewData["Title"] = "報表";
    // 大螢幕模式（戰情中心）只有這一頁提供：網址帶 display=wall 時由 _Layout 在 <html> 輸出 lf-wall 類別，
    // 側欄、頁首與提醒區在第一次繪製前就不顯示（等前端腳本才套用會在進頁時閃現側欄）
    if (string.Equals(Context.Request.Query["display"], "wall", StringComparison.Ordinal))
    {
        ViewData["DisplayMode"] = "wall";
    }
}

@* 版面依 docs/WEB-SPEC.md §9.6：工具列一列 → 視角切換 → 目前視角（總覽／處理成效／問題類型，同一頁切換，各自一屏看完）。
   總覽由上而下、由左而右就是主管的閱讀順序：現在要不要擔心 → 變好還是變壞 → 風險集中在哪 → 有沒有人在處理 → 數字可不可信。
   外層 .lf-report-page 佔滿可用高度，視角面板分配剩餘空間，不靠寫死的圖表像素高度（docs/DESIGN-SYSTEM.md §6a）。
   處理成效與問題類型延後載入：切過去才打各自的端點（reports.js）。 *@

<div class="lf-report-page">
    @* 大螢幕標頭列：只在大螢幕模式顯示（樣式表控制），取代工具列。條件文字與工具列左側由同一個函式填入 *@
    <div class="lf-wall-header lf-no-print" id="wall-header">
        <span class="lf-wall-header__brand">@Brand.Get().Name</span>
        <p class="lf-wall-header__period mb-0">
            <span class="lf-text-title" id="wall-period-title"></span>
            <span class="lf-text-meta" id="wall-period-meta"></span>
        </p>
        <p class="lf-wall-header__status mb-0" aria-live="polite">
            <span class="lf-text-meta" id="wall-updated"></span>
            <span class="lf-text-alert" id="wall-stale"></span>
        </p>
    </div>

    @* 大螢幕模式的離開鈕：滑鼠移動時出現、3 秒沒動作後淡出；鍵盤聚焦時一直看得到 *@
    <div class="lf-wall-exit lf-no-print" id="wall-exit"></div>

    <div class="lf-card lf-no-print lf-report-page__fixed" id="report-toolbar">
        <div class="lf-card__body">
            <form id="report-form" class="lf-report-toolbar">
                <div class="lf-report-toolbar__main">
                    @* 左側：目前條件的一行文字；內容由 reports.js 依實際套用的期間填入 *@
                    <p class="lf-report-toolbar__summary mb-0" aria-live="polite">
                        <span class="lf-text-title" id="report-period-title"></span>
                        <span class="lf-text-meta" id="report-period-meta"></span>
                    </p>

                    @* 右側：快捷期間、更多條件、大螢幕、列印。沒有主要動作，所以沒有 primary 按鈕 *@
                    <div class="lf-report-toolbar__actions">
                        <div class="btn-group btn-group-sm" role="group" aria-label="快捷期間">
                            <button type="button" class="btn btn-outline-secondary" data-range="1">昨日</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="7">近 7 天</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="30">近 30 天</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="90">近 90 天</button>
                        </div>
                        @* 「更多條件」按鈕由 reports.js 的 filterDisclosure 放在這裡，標籤帶已套用的條件數 *@
                        <span id="report-more-slot"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-report-fullscreen" hidden>大螢幕</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-print-report">列印 / 存成 PDF</button>
                    </div>
                </div>

                @* 次要條件收合面板：起訖日期、比較模式、處理狀態顯示範圍（單選，一個母體對應一組明確語意） *@
                <div class="lf-report-filters" id="report-filter-panel">
                    <div>
                        <label for="report-from" class="form-label lf-text-label mb-1">起始日期</label>
                        <input type="date" class="form-control form-control-sm" id="report-from" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="report-to" class="form-label lf-text-label mb-1">結束日期</label>
                        <input type="date" class="form-control form-control-sm" id="report-to" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="report-compare" class="form-label lf-text-label mb-1">比較模式</label>
                        <select class="form-select form-select-sm" id="report-compare">
                            <option value="previous">對比前一期</option>
                            <option value="yoy">對比去年同期</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="lf-toolbar__group-label">顯示範圍</span>
                        <div class="lf-toolbar__chips" id="report-scope-chips">
                            <button type="button" class="lf-chip active" data-scope="all">全部</button>
                            <button type="button" class="lf-chip" data-scope="unresolved">未結案</button>
                            <button type="button" class="lf-chip" data-scope="open">未處理</button>
                            <button type="button" class="lf-chip" data-scope="unassigned">未指派</button>
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-sm btn-primary">套用</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* 視角切換（分段控制）：網址 view= 同步；大螢幕與列印不顯示 *@
    <div class="lf-report-page__fixed lf-no-print" id="report-view-tabs">
        <div class="btn-group btn-group-sm" role="group" aria-label="報表視角" id="report-view-switch">
            <button type="button" class="btn btn-outline-secondary active" data-view="overview" aria-pressed="true">總覽</button>
            <button type="button" class="btn btn-outline-secondary" data-view="effectiveness" aria-pressed="false">處理成效</button>
            <button type="button" class="btn btn-outline-secondary" data-view="category" aria-pressed="false">問題類型</button>
        </div>
        @* 處理成效與問題類型不套用「顯示範圍」：範圍不是「全部」時在這裡說明（reports.js syncViewNotes） *@
        <span class="lf-text-meta" id="report-view-note" hidden>此視角不套用顯示範圍</span>
    </div>

    <p class="h5 d-none d-print-block" id="print-title"></p>

    @* ── 視角一：總覽 ─────────────────────────────────────────────────────────── *@
    <div class="lf-report-view" id="view-overview" data-view="overview">
        <p class="lf-report-view__unavailable lf-text-meta">此部分未能載入</p>

        @* 第一排四格外面多包一層普通 div：Bootstrap 的 .row 帶負的 margin-top，
           直接當 flex 子項時會讓高度計算多出十幾像素、逼出一條只捲得動幾像素的捲軸 *@
        <div class="lf-report-page__fixed" id="report-kpi-area">
            <div class="row g-3" id="report-kpi"></div>
        </div>

        @* 圖表區：兩列分配剩餘高度（見樣式表 .lf-report-page__charts）。
           每列用 CSS grid 而不是 Bootstrap .row，高度由容器決定，Chart.js 的 responsive 天然跟著縮放 *@
        <div class="lf-report-page__charts" id="report-charts">
            <div class="lf-report-page__row lf-report-page__row--top" id="report-row-top">
                <section class="lf-card" id="trend-section">
                    <div class="lf-card__header">
                        <h2 class="lf-card__title">風險趨勢</h2>
                        <div id="trend-toolbar"></div>
                    </div>
                    <div class="lf-card__body">
                        <div class="lf-chart" id="trend-wrapper"><canvas id="trend-chart"></canvas></div>
                    </div>
                </section>

                <section class="lf-card" id="handling-section">
                    <div class="lf-card__header">
                        <h2 class="lf-card__title">處理進度</h2>
                    </div>
                    <div class="lf-card__body lf-report-progress" id="handling-body"></div>
                </section>
            </div>

            @* 主機排行與問題排行並排兩張卡：排名比較用橫條；兩張各自有「檢視全部」與「表格」切換 *@
            <div class="lf-report-page__row lf-report-page__row--bottom">
                <section class="lf-card" id="host-section">
                    <div class="lf-card__header">
                        <div class="lf-report-rank-head">
                            <h2 class="lf-card__title mb-0">主機排行</h2>
                            <span class="lf-text-meta" id="host-rank-subtitle"></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-sm btn-outline-secondary lf-no-print d-none" id="host-view-all">檢視全部</a>
                            <div id="host-toolbar"></div>
                        </div>
                    </div>
                    <div class="lf-card__body">
                        <div class="lf-chart" id="host-wrapper"><canvas id="host-chart"></canvas></div>
                    </div>
                </section>

                <section class="lf-card" id="issue-section">
                    <div class="lf-card__header">
                        <div class="lf-report-rank-head">
                            <h2 class="lf-card__title mb-0">問題排行</h2>
                            <span class="lf-text-meta" id="issue-rank-subtitle"></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-sm btn-outline-secondary lf-no-print d-none" id="issue-view-all">檢視全部</a>
                            <div id="issue-toolbar"></div>
                        </div>
                    </div>
                    <div class="lf-card__body">
                        <div class="lf-chart" id="issue-wrapper"><canvas id="issue-chart"></canvas></div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @* ── 視角二：處理成效（延後載入）──────────────────────────────────────────── *@
    <div class="lf-report-view d-none" id="view-effectiveness" data-view="effectiveness">
        <p class="lf-report-view__unavailable lf-text-meta">此部分未能載入</p>
        @* 載入中的骨架列與失敗的「重試」畫在這裡，不覆蓋下面的圖表容器 *@
        <div class="lf-report-page__fixed" id="eff-status"></div>
        <div class="lf-report-page__charts" id="eff-body">
            <div class="lf-report-page__row lf-report-page__row--eff-top">
                <section class="lf-card" id="eff-buckets-section">
                    <div class="lf-card__header">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="lf-card__title mb-0">各時段的處理狀態</h2>
                            <span id="eff-buckets-help"></span>
                        </div>
                        <div id="eff-buckets-toolbar"></div>
                    </div>
                    <div class="lf-card__body">
                        <div class="lf-chart" id="eff-buckets-wrapper"><canvas id="eff-buckets-chart"></canvas></div>
                    </div>
                </section>

                <section class="lf-card" id="eff-aging-section">
                    <div class="lf-card__header">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="lf-card__title mb-0">未結案帳齡</h2>
                            <span id="eff-aging-help"></span>
                        </div>
                    </div>
                    <div class="lf-card__body lf-report-progress" id="eff-aging-body"></div>
                </section>
            </div>

            <div class="lf-report-page__row lf-report-page__row--eff-bottom">
                <section class="lf-card" id="eff-recur-section">
                    <div class="lf-card__header">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="lf-card__title mb-0">結案後再發生</h2>
                            <span id="eff-recur-help"></span>
                        </div>
                    </div>
                    <div class="lf-card__body lf-report-recur" id="eff-recur-body"></div>
                </section>
            </div>
        </div>
    </div>

    @* ── 視角三：問題類型（延後載入）──────────────────────────────────────────── *@
    <div class="lf-report-view d-none" id="view-category" data-view="category">
        <p class="lf-report-view__unavailable lf-text-meta">此部分未能載入</p>
        <div class="lf-report-page__charts" id="cat-body">
            <div class="lf-report-page__row lf-report-page__row--cat">
                <section class="lf-card" id="cat-section">
                    <div class="lf-card__header">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="lf-card__title mb-0">各類型的問題日</h2>
                            <span id="cat-help"></span>
                        </div>
                    </div>
                    <div class="lf-card__body lf-report-heat" id="cat-heat-body"></div>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script type="module" src="~/js/pages/reports.js" asp-append-version="true"></script>
}
