@{
    ViewData["Title"] = "報表";
}

@* 版面依 docs/WEB-SPEC.md §9.6：工具列一列 → 第一排四格 → 圖表區兩列。
   由上而下、由左而右就是主管的閱讀順序：現在要不要擔心 → 變好還是變壞 → 風險集中在哪 → 有沒有人在處理 → 數字可不可信。
   外層 .lf-report-page 佔滿可用高度，圖表區分配剩餘空間，不靠寫死的圖表像素高度（docs/DESIGN-SYSTEM.md §6a）。
   工具列、第一排、圖表區各自有 id，之後的大螢幕模式可以單獨隱藏。 *@

<div class="lf-report-page">
    <div class="lf-card lf-no-print lf-report-page__fixed" id="report-toolbar">
        <div class="lf-card__body">
            <form id="report-form" class="lf-report-toolbar">
                <div class="lf-report-toolbar__main">
                    @* 左側：目前條件的一行文字；內容由 reports.js 依實際套用的期間填入 *@
                    <p class="lf-report-toolbar__summary mb-0" aria-live="polite">
                        <span class="lf-text-title" id="report-period-title"></span>
                        <span class="lf-text-meta" id="report-period-meta"></span>
                    </p>

                    @* 右側：快捷期間、更多條件、大螢幕、列印。沒有主要動作，所以沒有 primary 按鈕 *@
                    <div class="lf-report-toolbar__actions">
                        <div class="btn-group btn-group-sm" role="group" aria-label="快捷期間">
                            <button type="button" class="btn btn-outline-secondary" data-range="1">昨日</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="7">近 7 天</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="30">近 30 天</button>
                            <button type="button" class="btn btn-outline-secondary" data-range="90">近 90 天</button>
                        </div>
                        @* 「更多條件」按鈕由 reports.js 的 filterDisclosure 放在這裡，標籤帶已套用的條件數 *@
                        <span id="report-more-slot"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-report-fullscreen" hidden>大螢幕</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-print-report">列印 / 存成 PDF</button>
                    </div>
                </div>

                @* 次要條件收合面板：起訖日期、比較模式、處理狀態顯示範圍（單選，一個母體對應一組明確語意） *@
                <div class="lf-report-filters" id="report-filter-panel">
                    <div>
                        <label for="report-from" class="form-label lf-text-label mb-1">起始日期</label>
                        <input type="date" class="form-control form-control-sm" id="report-from" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="report-to" class="form-label lf-text-label mb-1">結束日期</label>
                        <input type="date" class="form-control form-control-sm" id="report-to" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="report-compare" class="form-label lf-text-label mb-1">比較模式</label>
                        <select class="form-select form-select-sm" id="report-compare">
                            <option value="previous">對比前一期</option>
                            <option value="yoy">對比去年同期</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="lf-toolbar__group-label">顯示範圍</span>
                        <div class="lf-toolbar__chips" id="report-scope-chips">
                            <button type="button" class="lf-chip active" data-scope="all">全部</button>
                            <button type="button" class="lf-chip" data-scope="unresolved">未結案</button>
                            <button type="button" class="lf-chip" data-scope="open">未處理</button>
                            <button type="button" class="lf-chip" data-scope="unassigned">未指派</button>
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-sm btn-primary">套用</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <p class="h5 d-none d-print-block" id="print-title"></p>

    @* 第一排四格外面多包一層普通 div：Bootstrap 的 .row 帶負的 margin-top，
       直接當 flex 子項時會讓高度計算多出十幾像素、逼出一條只捲得動幾像素的捲軸 *@
    <div class="lf-report-page__fixed" id="report-kpi-area">
        <div class="row g-3" id="report-kpi"></div>
    </div>

    @* 圖表區：兩列分配剩餘高度（見樣式表 .lf-report-page__charts）。
       每列用 CSS grid 而不是 Bootstrap .row，高度由容器決定，Chart.js 的 responsive 天然跟著縮放 *@
    <div class="lf-report-page__charts" id="report-charts">
        <div class="lf-report-page__row lf-report-page__row--top" id="report-row-top">
            <section class="lf-card" id="trend-section">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">風險趨勢</h2>
                    <div id="trend-toolbar"></div>
                </div>
                <div class="lf-card__body">
                    <div class="lf-chart" id="trend-wrapper"><canvas id="trend-chart"></canvas></div>
                </div>
            </section>

            <section class="lf-card" id="handling-section">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">處理進度</h2>
                </div>
                <div class="lf-card__body lf-report-progress" id="handling-body"></div>
            </section>
        </div>

        <div class="lf-report-page__row lf-report-page__row--bottom">
            <section class="lf-card" id="host-section">
                <div class="lf-card__header">
                    <div class="d-flex align-items-center gap-2">
                        @* 同一張卡兩個視角（主機｜問題）——不另開一張卡，報表一屏化的高度是由外而內分配的 *@
                        <h2 class="lf-card__title mb-0" id="rank-title">主機排行</h2>
                        <span class="lf-text-meta" id="host-rank-subtitle"></span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm lf-no-print" id="rank-mode-toggle" role="group" aria-label="排行視角">
                            <button type="button" class="btn btn-outline-secondary active" data-rank-mode="host">主機</button>
                            <button type="button" class="btn btn-outline-secondary" data-rank-mode="issue">問題</button>
                        </div>
                        <a class="btn btn-sm btn-outline-secondary lf-no-print d-none" id="host-view-all">檢視全部</a>
                        <div id="host-toolbar"></div>
                    </div>
                </div>
                <div class="lf-card__body">
                    <div class="lf-chart" id="host-wrapper"><canvas id="host-chart"></canvas></div>
                </div>
            </section>

            <section class="lf-card" id="category-section">
                <div class="lf-card__header">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <h2 class="lf-card__title mb-0">風險類型分布</h2>
                        @* 問題總數：點進去是期間內全部問題的清單 *@
                        <a id="category-issue-total" hidden></a>
                        <span class="lf-text-meta" id="category-subtitle"></span>
                    </div>
                    <div id="category-toolbar"></div>
                </div>
                <div class="lf-card__body">
                    <div class="lf-chart" id="category-wrapper"><canvas id="category-chart"></canvas></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script type="module" src="~/js/pages/reports.js" asp-append-version="true"></script>
}
