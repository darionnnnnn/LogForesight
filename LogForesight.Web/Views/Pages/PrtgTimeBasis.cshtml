@{
    ViewData["Title"] = "PRTG 時間基準";
}

<section class="lf-card" aria-labelledby="prtg-time-basis-title">
    <div class="lf-card__header"><h1 class="lf-card__title" id="prtg-time-basis-title">PRTG 資料時間基準</h1></div>
    <div class="lf-card__body">
        <p class="small text-muted">這裡保存的是管理者明確輸入的設定，不表示已從 PRTG 帳號遠端讀回或已通過 native sample。Raw timestamp 時區不可由 API 回應時區或本機時區推定；正式資格仍會重新核驗來源樣本。</p>
        <form id="prtg-time-basis-form" class="vstack gap-2">
            <label class="form-label" for="prtg-time-basis-raw-zone">Raw timestamp 時區</label>
            <input class="form-control" id="prtg-time-basis-raw-zone" maxlength="128" autocomplete="off" required disabled />
            <div class="form-text">依目前 API 憑證所屬帳號與 raw date/time 來源證據確認；不要直接複製「PRTG 回應時間時區」。</div>

            <label class="form-label" for="prtg-time-basis-analysis-zone">Analysis 時區</label>
            <input class="form-control" id="prtg-time-basis-analysis-zone" maxlength="128" autocomplete="off" required disabled />
            <div class="form-text">這是 LogForesight 固定時槽採用的分析時區，請依正式分析需求明確選定。</div>

            <label class="form-label" for="prtg-time-basis-reference">時間基準來源參考</label>
            <input class="form-control" id="prtg-time-basis-reference" maxlength="128" autocomplete="off" required disabled placeholder="例如維運工單或設定核對記錄代碼" />
            <div class="form-text">只填可追查的參考代碼；不要填密碼、token 或原始資料。</div>

            <label class="form-check mt-2"><input class="form-check-input" id="prtg-time-basis-confirm" type="checkbox" required disabled />我已核對上方兩個時區及來源參考；此保存動作只記錄明確輸入，不代表來源已驗證。</label>
            <div id="prtg-time-basis-status" class="small" role="status" aria-live="polite">正在讀取目前保存狀態…</div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" id="prtg-time-basis-save" type="submit" disabled>保存時間基準</button>
                <button class="btn btn-outline-secondary" id="prtg-time-basis-reload" type="button" disabled>重新讀取目前設定</button>
                <a class="btn btn-outline-secondary" href="@Url.Content("~/admin/prtg")">返回 PRTG 維護</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/prtg-time-basis.js" asp-append-version="true"></script>
}
