@{
    ViewData["Title"] = "設定";
}

<ul class="nav nav-tabs mb-3" id="settings-tabs">
    <li class="nav-item"><button class="nav-link active" data-tab="levels" type="button">層級與顯示</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="ai" type="button">AI 服務</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="ad" type="button">AD 驗證</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="analysis" type="button">分析參數</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="retention" type="button">資料保留</button></li>
    <li class="nav-item"><button class="nav-link" data-tab="mail" type="button">郵件通知</button></li>
    @* 外觀（docs/archive/FEEDBACK-10-PLAN.md §1）：放最後一個頁籤——找 logo／名稱的人會直覺點「外觀」，
       塞進「層級與顯示」反而找不到；擺最後則不動預設落地頁籤（層級與顯示仍是主要入口） *@
    <li class="nav-item"><button class="nav-link" data-tab="brand" type="button">外觀</button></li>
</ul>

<form id="settings-form" novalidate>
    <div class="lf-card mb-3" data-panel="levels">
        <div class="lf-card__header">
            <h2 class="lf-card__title">層級與顯示</h2>
        </div>
        <div class="lf-card__body">
            <p class="text-muted small mb-2">
                以下設定僅套用於<strong>問題嚴重度</strong>（高／中／低，掛在單一問題上；
                特別嚴重的問題另以「重大」徽章標註，見規則維護頁）：
                「未處理」計算（未勾選的等級若從未被人明確標記過，會顯示「不處理（預設）」，
                不計入未處理數量；使用者仍可隨時手動「調回未處理」）與下方
                「未勾選層級的顯示方式」。
            </p>
            <p class="text-muted small mb-2">
                <strong>日風險等級</strong>（高／中／低風險日，儀表板與報表的「高風險日」等統計）
                由批次分析綜合規則、趨勢、關聯訊號算定，是事後不可改寫的證據層——
                這裡的勾選不會改變任何一天的判定結果，只影響下方「日風險等級顯示」設定
                控制的<strong>顯示範圍</strong>。
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3" id="severity-checks"></div>

            <label class="form-label small fw-semibold">未勾選層級的顯示方式</label>
            <div class="d-flex flex-wrap gap-2 mb-1" id="severity-display-mode"></div>
            <div class="form-text mb-3" id="severity-display-mode-hint"></div>

            <hr />

            <label class="form-label small fw-semibold">日風險等級顯示</label>
            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                    data-bs-content="「高風險日」為必要顯示項目，無法取消勾選。">
                <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
            </button>
            <p class="text-muted small mb-2">
                未勾選等級的風險日整批從儀表板 KPI、報表趨勢、問題查詢的統計與清單中消失
                （上方說明的判定結果本身不受影響）。風險日詳情的直接連結與主機詳情頁的時間軸
                不受此設定影響，兩處仍顯示完整證據——避免時間軸把「這天有分析但被藏起來」
                誤顯示成「這天沒有分析紀錄」。
            </p>
            <div class="d-flex flex-wrap gap-2 mb-1" id="day-risk-level-checks"></div>
        </div>
    </div>

    <div class="lf-card mb-3 d-none" data-panel="ai">
        <div class="lf-card__header">
            <h2 class="lf-card__title">AI 服務</h2>
        </div>
        <div class="lf-card__body">
            <div class="mb-3">
                <label for="ai-provider" class="form-label">服務提供者</label>
                <select class="form-select" id="ai-provider">
                    <option value="Local">本機 OpenAI 相容端點</option>
                    <option value="OpenAi">OpenAI 官方</option>
                    <option value="AzureOpenAi">Azure OpenAI</option>
                </select>
                <div class="form-text" id="ai-provider-hint"></div>
            </div>

            <div class="mb-3" id="ai-base-url-wrap">
                <label for="ai-base-url" class="form-label" id="ai-base-url-label">API 位址</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover" id="ai-base-url-help"
                        data-bs-content="OpenAI 相容端點（如 llama.cpp／KoboldCpp）。留空會停用 AI 分析與加值功能。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <input type="text" class="form-control" id="ai-base-url" placeholder="http://localhost:8080" />
                <div class="form-text" id="ai-base-url-hint"></div>
            </div>

            <div class="mb-3" id="ai-model-wrap">
                <label for="ai-model" class="form-label" id="ai-model-label">模型名稱</label>
                <input type="text" class="form-control" id="ai-model" placeholder="local-model" />
                <div class="form-text" id="ai-model-hint">選填，預設 local-model。</div>
            </div>

            <div class="mb-3 d-none" id="ai-azure-deployment-wrap">
                <label for="ai-azure-deployment" class="form-label">部署名稱（Deployment Name）</label>
                <input type="text" class="form-control" id="ai-azure-deployment" placeholder="例如 gpt-4o" />
                <div class="form-text">Azure OpenAI 建立的模型部署名稱。</div>
            </div>

            <div class="mb-3 d-none" id="ai-azure-api-version-wrap">
                <label for="ai-azure-api-version" class="form-label">API 版本</label>
                <input type="text" class="form-control" id="ai-azure-api-version" placeholder="2024-10-21" />
                <div class="form-text">Azure OpenAI API 版本，預設 2024-10-21。</div>
            </div>

            <div class="mb-2" id="ai-api-key-wrap">
                <label for="ai-api-key" class="form-label" id="ai-api-key-label">API 金鑰</label>
                <input type="password" class="form-control" id="ai-api-key" autocomplete="new-password" placeholder="留空＝沿用既有金鑰" />
                <div class="form-text" id="ai-api-key-hint"></div>
            </div>
            <div class="form-check" id="ai-api-key-clear-wrap">
                <input class="form-check-input" type="checkbox" id="ai-api-key-clear" />
                <label class="form-check-label" for="ai-api-key-clear">清除目前的 API 金鑰</label>
            </div>

            @* AI 進階參數（§12：自 appsettings 的 Ai 區段遷入）：折疊區，平常不必動 *@
            <hr />
            <details id="ai-advanced">
                <summary class="fw-semibold">進階參數（逾時／重試／token 上限／取樣）</summary>
                @* 還原預設值（docs/archive/FEEDBACK-10-PLAN.md §3）：只把欄位填回出廠值，仍需按「儲存」才生效
                   （整頁單一 form 語意，不做偷偷落盤）。放 summary 外側，避免點按鈕誤觸折疊 *@
                <div class="mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-ai-advanced-reset">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#arrow-counterclockwise"></use></svg>
                        還原預設值
                    </button>
                </div>
                <p class="text-muted small mt-2 mb-3">
                    預設值即原本 appsettings 的出廠值，平常不需調整。改動只影響**排程／立即執行**的批次分析
                    與 Web 互動情境共用的取樣參數；逾時與重試在互動情境另有更短的固定值（避免使用者盯著轉圈）。
                </p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="ai-timeout-seconds" class="form-label">單次呼叫逾時（秒）</label>
                        <input type="number" class="form-control" id="ai-timeout-seconds" min="1" max="3600" />
                        <div class="form-text">本機 27B 級模型單次回應可能需數分鐘</div>
                    </div>
                    <div class="col-md-4">
                        <label for="ai-retry-count" class="form-label">網路層重試次數</label>
                        <input type="number" class="form-control" id="ai-retry-count" min="1" max="10" />
                    </div>
                    <div class="col-md-4">
                        <label for="ai-retry-delay-seconds" class="form-label">首次重試等待（秒）</label>
                        <input type="number" class="form-control" id="ai-retry-delay-seconds" min="0" max="300" />
                        <div class="form-text">之後指數遞增（10 → 20 → 40）</div>
                    </div>
                    <div class="col-md-4">
                        <label for="ai-json-retry-count" class="form-label">JSON 檢查未過重問次數</label>
                        <input type="number" class="form-control" id="ai-json-retry-count" min="0" max="10" />
                    </div>
                    <div class="col-md-4">
                        <label for="ai-max-tokens" class="form-label">一般呼叫 token 上限</label>
                        <input type="number" class="form-control" id="ai-max-tokens" min="0" max="131072" />
                        <div class="form-text">0＝不設上限；抓緊可讓退化輸出更快觸頂</div>
                    </div>
                    <div class="col-md-4">
                        <label for="ai-deep-dive-max-tokens" class="form-label">深入分析 token 上限</label>
                        <input type="number" class="form-control" id="ai-deep-dive-max-tokens" min="0" max="131072" />
                    </div>
                    <div class="col-md-4">
                        <label for="ai-frequency-penalty" class="form-label">頻率懲罰</label>
                        <input type="number" class="form-control" id="ai-frequency-penalty" min="0" max="2" step="0.1" />
                        <div class="form-text">抑制反覆重複的退化輸出</div>
                    </div>
                    <div class="col-md-4">
                        <label for="ai-presence-penalty" class="form-label">存在懲罰</label>
                        <input type="number" class="form-control" id="ai-presence-penalty" min="0" max="2" step="0.1" />
                    </div>
                    <div class="col-12">
                        <label for="ai-extra-request-fields" class="form-label">額外請求欄位（JSON）</label>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-content="原封不動合併進送給 AI 的請求 JSON。伺服器不認得的欄位通常會被忽略、不會報錯，所以換 server/模型時務必對照對方的啟動設定或文件確認參數名稱（本專案實測的 KoboldCpp 認 rep_pen 與聊天範本的 enable_thinking 布林開關；原生 llama.cpp server 則是 repeat_penalty）。留空＝不附加任何欄位。">
                            <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                        </button>
                        <textarea class="form-control lf-mono" id="ai-extra-request-fields" rows="3"
                                  placeholder='{"rep_pen": 1.3}'></textarea>
                        <div class="form-text">必須是 JSON 物件；存檔時會驗證格式。</div>
                    </div>
                </div>
            </details>

            @* token 用量統計（回饋二十七輪作業 B）：單價跟著整頁 form 儲存，不另做儲存按鈕 *@
            <hr />
            <h3 class="h6">token 用量統計</h3>

            @* 三個數字摘要 *@
            <div class="row g-3 mb-2" id="ai-usage-summary">
                <div class="col-sm-4">
                    <div class="text-muted small">今日消耗</div>
                    <div class="fw-semibold" id="ai-usage-today-tokens">—</div>
                </div>
                <div class="col-sm-4">
                    <div class="text-muted small">
                        累計消耗
                        <span class="fw-normal" id="ai-usage-since"></span>
                    </div>
                    <div class="fw-semibold" id="ai-usage-total-tokens">—</div>
                </div>
                <div class="col-sm-4">
                    <div class="text-muted small">累計呼叫次數</div>
                    <div class="fw-semibold" id="ai-usage-total-calls">—</div>
                </div>
            </div>

            @* 未回報 token 提示（有時才顯示） *@
            <div class="text-muted small d-none mb-2" id="ai-usage-no-token-hint"></div>

            @* 單價輸入框（隨整頁 form 儲存，不另做按鈕） *@
            <div class="row g-3 mb-2">
                <div class="col-sm-4">
                    <label for="ai-input-price" class="form-label small">input 每百萬 token 金額</label>
                    <input type="number" class="form-control form-control-sm" id="ai-input-price"
                           min="0" step="0.01" placeholder="0" />
                    <div class="form-text">0＝不估費；幣別由使用者自行認定，僅供試算，不影響實際呼叫。</div>
                </div>
                <div class="col-sm-4">
                    <label for="ai-output-price" class="form-label small">output 每百萬 token 金額</label>
                    <input type="number" class="form-control form-control-sm" id="ai-output-price"
                           min="0" step="0.01" placeholder="0" />
                    <div class="form-text">0＝不估費；幣別由使用者自行認定，僅供試算，不影響實際呼叫。</div>
                </div>
                <div class="col-sm-4 d-flex align-items-end">
                    <div>
                        <div class="text-muted small">累計估算金額</div>
                        <div class="fw-semibold" id="ai-usage-cost">—</div>
                    </div>
                </div>
            </div>

            @* 清空重新計算按鈕 *@
            <div class="mb-2">
                <button type="button" class="btn btn-sm btn-outline-danger" id="btn-ai-usage-reset">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#trash"></use></svg>
                    清空重新計算
                </button>
                <span class="text-muted small ms-2" id="ai-usage-updated"></span>
            </div>

            @* 30 天明細（折疊，與「進階參數」同樣的 details 慣例） *@
            <details id="ai-usage-days">
                <summary class="fw-semibold">近 30 天明細</summary>
                <div class="mt-2" id="ai-usage-days-table"></div>
            </details>
        </div>
    </div>

    @* 分析參數（§12：自 appsettings 的 Permissions／Analysis／Import 區段遷入）*@
    <div class="lf-card mb-3 d-none" data-panel="analysis">
        <div class="lf-card__header">
            <h2 class="lf-card__title">分析參數</h2>
        </div>
        <div class="lf-card__body">
            <p class="text-muted small mb-3">
                以下分析與掃描參數儲存後，在<strong>下一次排程或立即執行時生效</strong>。
            </p>

            <div class="mb-3">
                <label for="server-description" class="form-label">伺服器角色描述</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="會帶入 prompt 讓 AI 依環境判讀——同一個事件在網域控制站與一般檔案伺服器上的嚴重性不同。留空＝略過。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <input type="text" class="form-control" id="server-description" placeholder="例如：公司機房的 AD 網域控制站" />
            </div>

            <div class="mb-3">
                <label for="checkup-interval-days" class="form-label">體檢間隔天數</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="距上次體檢達此天數即到期執行（due-date 輪巡，不綁固定星期幾）。漏跑時下次執行自動補上，體檢不會因此消失。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <input type="number" class="form-control" id="checkup-interval-days" min="1" max="365" style="max-width: 12rem;" />
            </div>

            <div class="mb-3">
                <label for="watched-folders" class="form-label">額外監控權限異動的資料夾</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="一行一個路徑，支援環境變數（如 %ProgramFiles%\YourApp）。本站台執行檔自身目錄一律自動監控，不必列在此。建議加入網站根目錄、應用程式安裝目錄等重要位置。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <textarea class="form-control lf-mono" id="watched-folders" rows="3"
                          placeholder="C:\inetpub\wwwroot&#10;%ProgramFiles%\YourApp"></textarea>
                <div class="form-text">一行一個路徑；留空＝只監控本站台執行檔目錄。</div>
            </div>

            <div class="mb-3">
                <label for="analysis-channels" class="form-label">要掃描的 Event Log 頻道</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="一行一個頻道全名。留空＝使用預設六頻道（System／Application／Security 三個傳統日誌，加上 Defender 與兩個 RDP TerminalServices Operational 頻道）。主機上不存在的頻道會誠實申報「不適用」，不會當成錯誤。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <textarea class="form-control lf-mono" id="analysis-channels" rows="3"
                          placeholder="留空＝預設六頻道"></textarea>
                <div class="form-text">一行一個頻道全名；留空＝預設六頻道。</div>
            </div>

            <hr />
            <h3 class="h6">權限異動自訂欄位對應</h3>
            <p class="text-muted small mb-3">
                事件訊息使用非標準欄位名時才需要設定，留空代表只使用內建的標準欄位名。
            </p>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="perm-operator-fields" class="form-label">操作者帳號自訂欄位</label>
                    <textarea class="form-control lf-mono" id="perm-operator-fields" rows="2" placeholder="一行一個欄位名"></textarea>
                    <div class="form-text">對應主體區段帳戶名稱；留空＝只用內建官方欄位名。</div>
                </div>
                <div class="col-md-6">
                    <label for="perm-member-fields" class="form-label">成員帳號自訂欄位</label>
                    <textarea class="form-control lf-mono" id="perm-member-fields" rows="2" placeholder="一行一個欄位名"></textarea>
                    <div class="form-text">對應成員區段帳戶名稱；留空＝只用內建官方欄位名。</div>
                </div>
                <div class="col-md-6">
                    <label for="perm-group-fields" class="form-label">群組名稱自訂欄位</label>
                    <textarea class="form-control lf-mono" id="perm-group-fields" rows="2" placeholder="一行一個欄位名"></textarea>
                    <div class="form-text">對應群組名稱；留空＝只用內建官方欄位名。</div>
                </div>
                <div class="col-md-6">
                    <label for="perm-object-fields" class="form-label">物件名稱自訂欄位</label>
                    <textarea class="form-control lf-mono" id="perm-object-fields" rows="2" placeholder="一行一個欄位名"></textarea>
                    <div class="form-text">對應物件名稱；留空＝只用內建官方欄位名。</div>
                </div>
            </div>

            <hr />
            <h3 class="h6">匯入上限</h3>
            <p class="text-muted small mb-3">
                CSV 匯入大小與列數限制，每次上傳時即時讀取、<strong>立刻生效</strong>。
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="import-max-file-size-kb" class="form-label">CSV 匯入檔案大小上限（KB）</label>
                    <input type="number" class="form-control" id="import-max-file-size-kb" min="1" max="102400" />
                </div>
                <div class="col-md-6">
                    <label for="import-max-rows" class="form-label">CSV 匯入資料列上限</label>
                    <input type="number" class="form-control" id="import-max-rows" min="1" max="1000000" />
                </div>
            </div>
        </div>
    </div>

    <div class="lf-card mb-3 d-none" data-panel="ad">
        <div class="lf-card__header">
            <h2 class="lf-card__title">AD 驗證</h2>
        </div>
        <div class="lf-card__body">
            @* 生效狀態一句話講完：AD 沒設定時一般帳號一律登入失敗，且失敗訊息與密碼打錯
               完全相同（刻意不洩漏帳號是否存在），沒有這行提示無從分辨。 *@
            <div class="alert d-none mb-3" id="ad-status" role="status"></div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="ad-auth-enabled" />
                <label class="form-check-label" for="ad-auth-enabled">啟用 AD 驗證</label>
                <div class="form-text">
                    開啟後，不論目前是測試模式還是正式模式，登入一律改用下方設定的 AD 伺服器驗證帳密，
                    設定儲存後立即生效、不必重啟站台。
                    <strong>本機救援帳號（serverAdmin）不受此設定影響</strong>——AD 設定若填錯把一般使用者
                    擋在門外，仍可用救援帳號登入處理，不會被鎖死。
                </div>
            </div>

            <div class="mb-3">
                <label for="ad-servers" class="form-label">AD 伺服器</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="一行一台，依序嘗試第一個可連線者。可填 IP 或主機名稱／FQDN。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <textarea class="form-control" id="ad-servers" rows="3" placeholder="一行一台，例如：&#10;dc1.corp.local&#10;dc2.corp.local"></textarea>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary mb-3" data-bs-toggle="collapse" data-bs-target="#ad-advanced">
                進階設定
            </button>
            <div class="collapse mb-3" id="ad-advanced">
                <div class="mb-3">
                    <label for="ad-search-base" class="form-label">查詢基準 DN（選填）</label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="留空使用目錄預設根目錄。">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                    </button>
                    <input type="text" class="form-control" id="ad-search-base" placeholder="DC=corp,DC=local" />
                </div>
                <div class="mb-3">
                    <label for="ad-search-filter" class="form-label">查詢過濾器</label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="{0} 會被代入登入帳號。AD 預設 (sAMAccountName={0})。">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                    </button>
                    <input type="text" class="form-control" id="ad-search-filter" placeholder="(sAMAccountName={0})" />
                </div>
            </div>

            <hr />

            <h3 class="h6">測試連線</h3>
            <p class="text-muted small">
                用你自己的 AD 帳密，測試以上設定是否能連上並驗證成功（尚未儲存也可以測）。密碼只用於這次測試，不會被儲存。
            </p>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-sm-5">
                    <label for="ad-test-account" class="form-label small mb-1">測試帳號</label>
                    <input type="text" class="form-control form-control-sm" id="ad-test-account" />
                </div>
                <div class="col-sm-5">
                    <label for="ad-test-password" class="form-label small mb-1">測試密碼</label>
                    <input type="password" class="form-control form-control-sm" id="ad-test-password" autocomplete="off" />
                </div>
                <div class="col-sm-2">
                    <button type="button" class="btn btn-sm btn-outline-primary w-100" id="ad-test-btn">測試連線</button>
                </div>
            </div>
            <div id="ad-test-result"></div>
        </div>
    </div>

    <div class="lf-card mb-3 d-none" data-panel="retention">
        <div class="lf-card__header">
            <h2 class="lf-card__title">資料保留</h2>
        </div>
        <div class="lf-card__body">
            <div class="alert mb-3" style="background-color: var(--lf-warning-soft); color: var(--lf-warning-text); border-color: var(--lf-warning);">
                超過保留天數的資料會在每次批次啟動時<strong>永久刪除，無法復原</strong>（不含最下方的「首次執行回補天數」，它不刪任何資料）。
            </div>

            @* 問題聚合欄背景回填狀態（回饋十三輪 A6，體檢 G2 殘餘）：回填未完成時問題排行的
               次數與影響範圍會偏低但看起來正常，過去只有 /api/health/detail 有這三個欄位、
               維運端沒有任何畫面讀取點。只在真的回填中才顯示，平常不佔版面 *@
            <div class="alert alert-info d-none" id="backfill-status" role="status"></div>

            <div class="mb-3">
                <label for="retention-days" class="form-label">歷史資料保留天數</label>
                <div class="text-muted small mb-2">
                    刪除超過天數的分析紀錄、問題處理狀態、每日處理紀錄、案件與匯出的報告檔。不可小於首次執行回補天數。
                </div>
                <input type="number" class="form-control" id="retention-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>

            <div class="mb-3">
                <label for="raw-event-retention-days" class="form-label">原始事件內容保留天數</label>
                <div class="text-muted small mb-2">
                    刪除原始事件文字：每日紀錄的樣本訊息，以及規則命中／趨勢異常的事件暫存（「詢問 AI」會優先取用這份暫存）。刪除後該日的統計、風險等級與問題清單仍在，只是看不到原始訊息。不可大於歷史資料保留天數。
                </div>
                <input type="number" class="form-control" id="raw-event-retention-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>

            <div class="mb-3">
                <label for="run-log-retention-days" class="form-label">執行歷程保留天數</label>
                <div class="text-muted small mb-2">
                    刪除批次執行紀錄／診斷與匯入紀錄；只影響維運追蹤，不影響業務分析結果。
                </div>
                <input type="number" class="form-control" id="run-log-retention-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>

            <div class="mb-3">
                <label for="audit-retention-days" class="form-label">稽核與追責紀錄保留天數</label>
                <div class="text-muted small mb-2">
                    這一項同時控制三種資料：操作稽核紀錄、權限異動紀錄、處理歷程。合規與追責用途，保留期通常最長。
                </div>
                <input type="number" class="form-control" id="audit-retention-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>

            <div class="mb-3">
                <label for="report-retention-days" class="form-label">報告保留天數</label>
                <div class="text-muted small mb-2">
                    這一項管三種報告的全文（風險報告、體檢報告、權限異動報告）。<strong>報告全文存在資料庫裡，會佔用資料庫空間</strong>——單份約 20～30 KB，主機數量多、風險日多的環境累積得很快，設定前請一併衡量資料庫的容量規劃。
                </div>
                <div class="text-muted small mb-2">
                    不可大於歷史資料保留天數：超過之後對應的分析紀錄已被清除，那些報告在網站上不再有任何入口可以點開，留著只會佔空間。
                </div>
                <div class="alert alert-secondary py-2 px-3 small mb-2" id="report-usage" role="status" style="max-width: 32rem;">
                    目前已存報告：<span id="report-usage-count">—</span> 份，佔用約 <span id="report-usage-size">—</span> MB。
                </div>
                <input type="number" class="form-control" id="report-retention-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>

            <hr />

            <h3 class="h6">首次執行回補</h3>
            <div class="mb-3">
                <label for="initial-history-days" class="form-label">首次執行回補天數</label>
                <div class="text-muted small mb-2">
                    歷史資料庫全空時（首次執行），一次回補多少天的歷史，讓趨勢分析一開始就有基準資料。此設定僅決定首次執行的回溯天數，不會刪除任何資料。
                </div>
                <input type="number" class="form-control" id="initial-history-days" min="90" max="3650" required style="max-width: 12rem;" />
            </div>
        </div>
    </div>

    @* 郵件通知（docs/archive/FEEDBACK-15-PLAN.md 批次D）：SMTP 連線＋收件人＋三路觸發開關。
       版面比照「AD 驗證」區塊（連線設定＋折疊進階＋測試按鈕） *@
    <div class="lf-card mb-3 d-none" data-panel="mail">
        <div class="lf-card__header">
            <h2 class="lf-card__title">郵件通知</h2>
        </div>
        <div class="lf-card__body">
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mail-enabled" />
                <label class="form-check-label" for="mail-enabled">啟用郵件通知</label>
                <div class="form-text">
                    關閉時，下方三路觸發（執行摘要／每日／每週／高風險即時）全部不寄送；「測試寄信」不受此開關影響。
                </div>
            </div>

            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label for="smtp-server" class="form-label">SMTP 伺服器</label>
                    <input type="text" class="form-control" id="smtp-server" placeholder="smtp.corp.local" />
                </div>
                <div class="col-md-3">
                    <label for="smtp-port" class="form-label">Port</label>
                    <input type="number" class="form-control" id="smtp-port" min="1" max="65535" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="smtp-use-tls" />
                        <label class="form-check-label" for="smtp-use-tls">使用 TLS</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="smtp-account" class="form-label">SMTP 帳號（選填）</label>
                    <input type="text" class="form-control" id="smtp-account" placeholder="留空＝匿名／不驗證" />
                </div>
                <div class="col-md-6">
                    <label for="smtp-password" class="form-label">SMTP 密碼</label>
                    <input type="password" class="form-control" id="smtp-password" autocomplete="new-password" placeholder="留空＝沿用既有密碼" />
                    <div class="form-text" id="smtp-password-hint"></div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="smtp-password-clear" />
                        <label class="form-check-label" for="smtp-password-clear">清除目前的 SMTP 密碼</label>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label for="mail-from" class="form-label">寄件人</label>
                    <input type="text" class="form-control" id="mail-from" placeholder="logforesight@corp.local" />
                </div>
            </div>

            <div class="mb-3">
                <label for="mail-recipients" class="form-label">收件人</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="一行一位，全域收件人，三路通知共用。「同時通知負責人」勾選時，每個主機日的通知對象優先給該日問題的問題負責人（於「問題負責人」頁設定）；沒有問題負責人命中時才改通知主機負責人，兩者擇一、不疊加。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <textarea class="form-control" id="mail-recipients" rows="3" placeholder="一行一位，例如：&#10;ops@corp.local"></textarea>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mail-notify-host-owners" />
                <label class="form-check-label" for="mail-notify-host-owners">同時通知負責人（問題負責人優先，其次主機負責人）</label>
            </div>
            <div class="alert alert-warning py-2 px-3 small d-none" id="mail-suspended-recipients-wrap">
                <strong>已暫停寄送的收件人</strong>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="這些地址連續寄送失敗達 3 次，已自動排除避免拖累其他收件人；通常代表地址打錯。修正地址後儲存本頁設定即可重新嘗試。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <div id="mail-suspended-recipients-list" class="lf-mono mt-1"></div>
            </div>

            <hr />

            <div class="mb-3">
                <label for="mail-min-risk-level" class="form-label">摘要納入門檻</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="執行摘要與每日／每週彙總只納入達此風險等級以上的主機日；高風險即時通知固定只看「高」，不受此設定影響。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <select class="form-select" id="mail-min-risk-level" style="max-width: 12rem;">
                    <option value="高">高</option>
                    <option value="中">中以上</option>
                    <option value="低">低以上</option>
                </select>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="mail-on-run-completed" />
                <label class="form-check-label" for="mail-on-run-completed">排程／手動執行結束後寄執行摘要</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="mail-urgent-enabled" />
                <label class="form-check-label" for="mail-urgent-enabled">高風險日即時通知</label>
                <div class="form-text">不受下方每日／每週時刻限制；每台主機同一天只寄一次。</div>
            </div>

            <div class="row g-3 align-items-end mb-2">
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="mail-daily-enabled" />
                        <label class="form-check-label" for="mail-daily-enabled">每日摘要</label>
                    </div>
                </div>
                <div class="col-auto">
                    <label for="mail-daily-time" class="form-label small mb-1">時刻</label>
                    <input type="time" class="form-control form-control-sm" id="mail-daily-time" />
                </div>
            </div>
            <div class="row g-3 align-items-end mb-3">
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="mail-weekly-enabled" />
                        <label class="form-check-label" for="mail-weekly-enabled">每週摘要</label>
                    </div>
                </div>
                <div class="col-auto">
                    <label for="mail-weekly-day" class="form-label small mb-1">星期</label>
                    <select class="form-select form-select-sm" id="mail-weekly-day">
                        <option value="Monday">星期一</option>
                        <option value="Tuesday">星期二</option>
                        <option value="Wednesday">星期三</option>
                        <option value="Thursday">星期四</option>
                        <option value="Friday">星期五</option>
                        <option value="Saturday">星期六</option>
                        <option value="Sunday">星期日</option>
                    </select>
                </div>
                <div class="col-auto">
                    <label for="mail-weekly-time" class="form-label small mb-1">時刻</label>
                    <input type="time" class="form-control form-control-sm" id="mail-weekly-time" />
                </div>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mail-digest-skip-empty" />
                <label class="form-check-label" for="mail-digest-skip-empty">期間內無達門檻風險日時不寄摘要信</label>
                <div class="form-text">預設仍照寄——「期間內無事」的信同時是系統存活訊號，關閉後只在有達門檻風險日時才收到每日／每週摘要。</div>
            </div>

            <hr />

            <div class="mb-3">
                <label for="mail-subject-template" class="form-label">標題模板</label>
                <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                        data-bs-content="可用變數：{site}＝品牌名稱、{host}＝主機、{date}＝日期、{risk}＝風險等級、{type}＝通知種類、{summary}＝摘要文字。">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                </button>
                <input type="text" class="form-control lf-mono" id="mail-subject-template" placeholder="[{site}] {type}：{date} {summary}" />
            </div>
            <div class="mb-3">
                <label for="mail-body-intro" class="form-label">信件開頭（選填）</label>
                <textarea class="form-control" id="mail-body-intro" rows="2" placeholder="純文字，會加在信件內容最前面"></textarea>
            </div>

            <hr />

            <h3 class="h6">測試寄信</h3>
            <p class="text-muted small">
                用上方表單目前填的值試寄一封信（尚未儲存也可以測）；密碼欄留空時 fallback 已儲存的密碼。
            </p>
            <div class="d-flex align-items-center gap-2 mb-2">
                <button type="button" class="btn btn-sm btn-outline-primary" id="mail-test-btn">測試寄信</button>
            </div>
            <div id="mail-test-result"></div>
        </div>
    </div>

    @* 外觀／品牌（docs/archive/FEEDBACK-10-PLAN.md §1）：側欄與登入頁的主標題、副標題與圖示。
       伺服器端渲染，存檔後重新整理即生效 *@
    <div class="lf-card mb-3 d-none" data-panel="brand">
        <div class="lf-card__header">
            <h2 class="lf-card__title">外觀</h2>
        </div>
        <div class="lf-card__body">
            <p class="text-muted small mb-3">
                套用於左側選單頂端與登入頁。改動存檔後<strong>重新整理頁面</strong>即可看到。
            </p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="brand-name" class="form-label">主標題</label>
                    <input type="text" class="form-control" id="brand-name" maxlength="40" placeholder="LogForesight" />
                    <div class="form-text">留空＝使用出廠名稱 LogForesight。</div>
                </div>
                <div class="col-md-6">
                    <label for="brand-subtitle" class="form-label">副標題</label>
                    <input type="text" class="form-control" id="brand-subtitle" maxlength="40" placeholder="事件日誌預警" />
                    <div class="form-text">留空＝不顯示副標題，只留主標題。副標題比主標題短時自動撐開字距左右對齊，較長時靠左對齊。</div>
                </div>

                <div class="col-12">
                    <label for="brand-icon-file" class="form-label">圖示</label>
                    <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                            data-bs-content="PNG 或 JPG，64KB 以內。顯示尺寸只有約 30 像素，不需要大圖。未上傳時使用內建圖示。">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#question-circle"></use></svg>
                    </button>
                    <div class="d-flex align-items-center gap-3">
                        <span class="lf-brand-preview" id="brand-icon-preview"></span>
                        <div class="flex-grow-1">
                            <input type="file" class="form-control" id="brand-icon-file" accept="image/png,image/jpeg" />
                            <div class="form-text" id="brand-icon-hint"></div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="brand-icon-clear">
                            移除圖示
                        </button>
                    </div>
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="brand-reset">
                        <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#arrow-counterclockwise"></use></svg>
                        還原預設外觀
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3 lf-settings-footer">
        <button type="submit" class="btn btn-primary" id="settings-save">儲存</button>
        <span class="text-muted small" id="settings-updated"></span>
    </div>
</form>

@section Scripts {
    <script type="module" src="~/js/pages/settings.js" asp-append-version="true"></script>
}
