@{
    ViewData["Title"] = "操作說明書";
}

<div class="lf-card mb-3" id="help-ask-card">
    <div class="lf-card__header">
        <h2 class="lf-card__title">
            詢問說明書
            <span class="lf-badge lf-badge--warning ms-1">實驗性</span>
        </h2>
    </div>
    <div class="lf-card__body">
        <div id="help-ask-unavailable" class="text-muted small d-none">
            未設定 AI 服務，僅提供文件瀏覽。AI 位址請至「系統管理 &gt; 設定 &gt; AI 服務」頁設定。
        </div>
        <div id="help-ask-form-wrap" class="d-none">
            <p class="text-muted small mb-2">
                單輪問答，不保留對話歷史；只依據下方說明書內容作答，說明書沒寫的會誠實告知未涵蓋。
            </p>
            <form id="help-ask-form" class="d-flex gap-2 mb-2">
                <input type="text" class="form-control" id="help-ask-input" maxlength="500"
                       placeholder="例如：怎麼抑制某條規則的告警？" autocomplete="off" />
                <button type="submit" class="btn btn-primary" id="help-ask-submit">提問</button>
            </form>
            <div id="help-ask-result"></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="lf-card">
            <div class="lf-card__header">
                <h2 class="lf-card__title">章節目錄</h2>
            </div>
            <div class="lf-card__body p-0">
                <div class="list-group list-group-flush" id="help-chapter-nav"></div>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="lf-card">
            <div class="lf-card__header">
                <h2 class="lf-card__title" id="help-chapter-title"></h2>
            </div>
            <div class="lf-card__body">
                <div id="help-chapter-content"></div>
                <div id="help-chapter-related" class="mt-3 pt-3 border-top d-none"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/help-manual.js" asp-append-version="true"></script>
}
