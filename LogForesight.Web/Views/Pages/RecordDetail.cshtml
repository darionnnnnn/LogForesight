@{
    ViewData["Title"] = "風險日詳情";
    ViewData["ContentWidth"] = "bounded";
}

@*
    頁面殼：初始參數以 data-* 屬性傳給 JS（§8.1——cshtml 內不寫 inline script、
    不用 Razor 內插 JS 變數）。
*@
<div id="record-detail"
     data-host-id="@ViewData["HostId"]"
     data-date="@ViewData["Date"]">

    <div id="page-header"></div>

    <div id="detail-header"></div>

    <h2 class="h5 mt-3 mb-0">結論與處理</h2>

    @* 兩欄版面（第 66 輪 D2）：≥ lg 時右欄預設收成直式側軌、點了才展開；< lg 與列印恢復上下堆疊。
       側軌由 record-detail.js 的 createSideRail 動態建立（案件授與檢視不建立，右欄直接展開） *@
    <div class="lf-detail-layout mt-1" id="record-layout">
        <div class="lf-detail-main">
            <section class="lf-card mb-3">
                <div class="lf-card__header">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="lf-card__title mb-0">重點問題</h2>
                        <span class="text-muted small" id="detail-progress"></span>
                    </div>
                    <div class="d-flex align-items-center gap-2 lf-no-print">
                        <div class="btn-group btn-group-sm" id="detail-severity-filter" role="group" aria-label="依嚴重度篩選"></div>
                        @* 顯示範圍（docs/archive/FEEDBACK-10-PLAN.md §8）：與嚴重度篩選 AND 疊加。
                           預設「待處理」隱藏他人處理中的問題——避免兩個人同時動同一個問題 *@
                        <select class="form-select form-select-sm w-auto" id="detail-scope" aria-label="顯示範圍"></select>
                    </div>
                </div>
                <div class="lf-card__body p-0" id="detail-issues"></div>
            </section>

            <section class="lf-card d-none mb-3 lf-no-print" id="chat-card">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">詢問 AI（實驗性）</h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small" id="chat-turn-count"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="chat-expand">放大檢視</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="chat-clear">
                            <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#arrow-counterclockwise"></use></svg>
                            清除重來
                        </button>
                    </div>
                </div>
                <div class="lf-card__body">
                    @* #chat-body 整組（焦點列／訊息／輸入表單）在「放大檢視」時被搬移進全螢幕 modal，
                       關閉後搬回這裡——見 chat-panel.js、ui.js showDetailModal 的 onClose 說明 *@
                    <div id="chat-body">
                        <div class="text-muted small mb-2 d-none" id="chat-run-hint">分析執行中，AI 回應可能較慢。</div>
                        <div id="chat-focus" class="lf-chat-focus mb-2" role="group" aria-label="焦點問題"></div>
                        <div id="chat-focus-picker" class="lf-focus-picker mb-2 d-none" role="group" aria-label="指定問題"></div>
                        <div id="chat-messages" class="mb-2 lf-chat-messages"></div>
                        <form id="chat-form" class="d-flex gap-2">
                            <label for="chat-input" class="visually-hidden">發問</label>
                            <input type="text" class="form-control form-control-sm" id="chat-input"
                                   placeholder="直接發問，可以同時問多個問題，例如：4625 和 4735 有關聯嗎？" maxlength="500" />
                            <button type="submit" class="btn btn-sm btn-primary" id="chat-send">送出</button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- 報告全文（風險／體檢）由 core/report-view.js 掛載：三種報告共用同一個卡片元件，
                 版面與鍵盤行為不會因為頁面不同而長歪 -->
            <div id="report-cards" class="d-flex flex-column gap-3"></div>
        </div>

        <aside class="lf-detail-side" id="record-side" aria-label="處理與輔助資訊">
          <div class="lf-detail-side__body">
            <section class="lf-card mb-3">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">處理狀態</h2>
                </div>
                <div class="lf-card__body" id="handling-panel"></div>
            </section>

            <section class="lf-card mb-3" id="handling-log-card">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">處理歷程</h2>
                    <button type="button" class="btn btn-sm btn-outline-secondary lf-no-print d-none" id="handling-log-expand">放大檢視</button>
                </div>
                <div class="lf-card__body" id="handling-log"></div>
            </section>

            <section class="lf-card mb-3" id="alerts-card">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">程式偵測訊號</h2>
                </div>
                <div class="lf-card__body" id="detail-alerts"></div>
            </section>

            <section class="lf-card mb-3" id="categories-card">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">類型分布</h2>
                </div>
                <div class="lf-card__body" id="detail-categories"></div>
            </section>

            <section class="lf-card" id="coverage-card">
                <div class="lf-card__header">
                    <h2 class="lf-card__title">資料涵蓋率</h2>
                </div>
                <div class="lf-card__body" id="detail-coverage"></div>
            </section>
          </div>
        </aside>
    </div>

    <details class="lf-card mb-3 mt-3" id="record-context">
        <summary class="lf-card__header"><h2 class="lf-card__title">脈絡</h2></summary>
        <div class="lf-card__body row g-3">
            <div class="col-lg-8" id="record-context-main"></div>
            <div class="col-lg-4" id="record-context-side"></div>
        </div>
    </details>

    <details class="lf-card mb-3" id="record-evidence">
        <summary class="lf-card__header"><h2 class="lf-card__title">證據</h2></summary>
        <div class="lf-card__body row g-3">
            <div class="col-lg-8" id="record-evidence-main"></div>
            <div class="col-lg-4" id="record-evidence-side"></div>
        </div>
    </details>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/record-detail.js" asp-append-version="true"></script>
}
