@{
    ViewData["Title"] = "處理人員工作頁";
}

<div id="handler-detail" data-user-id="@ViewData["UserId"]">
    <div id="handler-header"></div>

    <div class="row g-3 mt-1" id="handler-kpi"></div>

    @* 處理人的工作單位是交辦單：主區塊只有交辦單清單，列上就能回覆（DESIGN-SYSTEM §6b）；
       「依主機」與「被指派的風險日」收進下方進階檢視，第一次展開才載入。 *@
    <section class="lf-card mt-3">
        <div class="lf-card__body">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <label for="handler-wo-status" class="form-label mb-0 text-muted small text-nowrap">狀態</label>
                    <select id="handler-wo-status" class="form-select form-select-sm w-auto">
                        <option value="active" selected>進行中</option>
                        <option value="escalated">上報中</option>
                        <option value="overdue">有逾期</option>
                        <option value="unreplied">未回覆</option>
                        <option value="closed">已結案</option>
                        <option value="all">全部</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="handler-wo-sort" class="form-label mb-0 text-muted small text-nowrap">排序</label>
                    <select id="handler-wo-sort" class="form-select form-select-sm w-auto">
                        <option value="created_desc" selected>最新建立</option>
                        <option value="members_desc">成員最多</option>
                        <option value="unreplied_oldest">最久未回覆</option>
                    </select>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="handler-wo-paused">
                    <label class="form-check-label small" for="handler-wo-paused">只看暫停的單</label>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                    <span class="small text-muted d-none" id="handler-wo-selected"></span>
                    <button type="button" class="btn btn-sm btn-outline-primary d-none" id="handler-wo-reply" disabled>回覆選取的單（全部進行中主機）</button>
                </div>
            </div>
            <div id="handler-wo-list"></div>
            <nav id="handler-wo-pager" class="mt-3"></nav>
            <div id="handler-wo-note" class="text-muted small mt-2 d-none"></div>
        </div>
    </section>

    <details class="lf-card mt-3" id="handler-advanced">
        <summary class="lf-card__body fw-semibold">進階檢視：依主機、被指派的風險日</summary>
        <div class="lf-card__body pt-0">
            <h3 class="h6 mt-2">依主機</h3>
            <div class="text-muted small mb-2">每台主機上被交辦給你的問題，狀態會跟著交辦單同步</div>
            <div id="handler-cases"></div>

            <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 mb-2">
                <h3 class="h6 mb-0">被指派的風險日</h3>
                <div class="form-check form-switch lf-no-print">
                    <input class="form-check-input" type="checkbox" id="toggle-resolved-days">
                    <label class="form-check-label small text-muted" for="toggle-resolved-days">顯示近 30 天已結案</label>
                </div>
            </div>
            <div id="handler-days"></div>
        </div>
    </details>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/handler-detail.js" asp-append-version="true"></script>
}
