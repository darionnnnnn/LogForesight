@{
    ViewData["Title"] = "問題檔案";
}

<section class="lf-card">
    <div class="lf-card__header">
        <h2 class="lf-card__title">問題檔案</h2>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                    data-bs-content="以「問題（來源＋Event ID）」為單位記錄負責人與機房結論，跨主機生效。負責人優先於主機負責人：自動帶入處理人、郵件通知路由都會先看問題負責人，沒有命中才落回主機負責人，也自動取得曾出現其負責問題之主機的檢視權。機房結論勾選「自動套用」後，之後新出現的主機日會沿用同一個結論，不必每次重新標記。">
                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
            </button>
            <button type="button" class="btn btn-sm btn-primary" id="issue-owner-new">
                <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#plus-lg"></use></svg>
                新增規則
            </button>
        </div>
    </div>
    <div class="lf-card__body p-0" id="issue-owner-list"></div>
</section>

<div class="modal fade" id="issue-owner-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="issue-owner-modal-title">新增問題檔案</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <form id="issue-owner-form" novalidate>
                <div class="modal-body">
                    <div class="mb-3" id="issue-owner-picker-field">
                        <label class="form-label">問題</label>
                        <button type="button" class="lf-help" tabindex="0" data-bs-toggle="popover"
                                data-bs-content="從近 30 天出現過的問題挑選；若要指派的問題還沒出現過，切換到「手動輸入」。">
                            <svg class="lf-icon" aria-hidden="true"><use href="/img/icons.svg#question-circle"></use></svg>
                        </button>
                        <select class="form-select" id="issue-owner-picker"></select>
                        <button type="button" class="btn btn-link btn-sm px-0 mt-1" id="issue-owner-manual-toggle">
                            找不到？改為手動輸入
                        </button>
                    </div>
                    <div class="row g-3 mb-3 d-none" id="issue-owner-manual-field">
                        <div class="col-md-8">
                            <label for="issue-owner-source" class="form-label">來源（Source） <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="issue-owner-source" placeholder="例如 disk、DCOM" />
                        </div>
                        <div class="col-md-4">
                            <label for="issue-owner-event-id" class="form-label">Event ID <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="issue-owner-event-id" min="0" />
                        </div>
                    </div>
                    <div class="mb-3" id="issue-owner-selected-summary"></div>
                    <div class="mb-3">
                        <label class="form-label">負責人</label>
                        <div id="issue-owner-users" class="border rounded p-2" style="max-height: 220px; overflow-y: auto;"></div>
                    </div>
                    <div class="mb-3">
                        <label for="issue-owner-note" class="form-label">備註（選填）</label>
                        <textarea class="form-control" id="issue-owner-note" rows="2"></textarea>
                    </div>

                    <div id="issue-owner-conclusion-section" class="d-none">
                        <hr />
                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <label class="form-label mb-0">機房結論</label>
                                <button type="button" class="btn btn-link btn-sm px-0 d-none" id="issue-owner-conclusion-clear">
                                    解除結論
                                </button>
                            </div>
                            <div id="issue-owner-conclusion-current" class="lf-hint mb-2"></div>
                            <select class="form-select form-select-sm mb-2" id="issue-owner-conclusion-status">
                                <option value="">（不設定機房結論）</option>
                                <option value="resolved">已處理</option>
                                <option value="wont_fix">不處理</option>
                                <option value="false_positive">誤報</option>
                                <option value="known_noise">已知雜訊</option>
                            </select>
                            <div id="issue-owner-conclusion-fields" class="d-none">
                                <textarea class="form-control form-control-sm mb-2" id="issue-owner-conclusion-note" rows="2"
                                          placeholder="原因（必填）——這是代全體下結論的操作，理由要留在紀錄裡。"></textarea>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="issue-owner-conclusion-auto-apply" />
                                    <label class="form-check-label small" for="issue-owner-conclusion-auto-apply">
                                        之後新出現的主機日也自動套用這個結論
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="issue-owner-save">儲存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/issue-owners.js" asp-append-version="true"></script>
}
