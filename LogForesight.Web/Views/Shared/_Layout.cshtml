@*
    主版面（docs/WEB-SPEC.md §8.2 版面骨架、§8.5 頁面殼）。
    View 只有結構、沒有資料——側欄選單由 core/layout.js 依 /api/auth/me 回傳的能力渲染。
    唯一的例外是品牌三元素（docs/archive/FEEDBACK-10-PLAN.md §1）：那是每頁第一眼看到的東西，
    等前端 fetch 回來才替換會閃動，所以伺服器端就渲染好。
*@
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject LogForesight.Web.Services.IBrandProvider Brand
@{
    // 頁尾顯示版本號（docs/archive/HISTORY.md P1-4）：報修時能確認回報者手上的部署是哪個版本
    // （Directory.Build.props 的 <Version>，全專案共用同一個版本號）。
    var appVersion = typeof(LogForesight.Web.Configuration.WebAppSettings).Assembly.GetName().Version;
    var brand = Brand.Get();
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brand.Name</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* 站台掛載路徑（IIS 子 Application 時是 /LogForesight 這種前綴）：前端的連結組裝與
       API 呼叫靠它補前綴，見 wwwroot/js/core/paths.js 的 appUrl()。必須早於任何 module。 *@
    <script>window.LF_BASE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Request.PathBase.ToUriComponent()));</script>
</head>
<body>
    <div class="lf-layout">
        <aside class="lf-sidebar lf-no-print">
            <partial name="_Brand" model="brand" view-data='new ViewDataDictionary(ViewData) { ["BrandVariant"] = "sidebar", ["BrandHref"] = Url.Content("~/") }' />
            <nav class="lf-sidebar__nav" id="lf-nav"></nav>
            <div class="lf-sidebar__footer">
                <div class="lf-sidebar__user">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#people"></use></svg>
                    <span id="lf-current-user" class="text-truncate"></span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light w-100" id="lf-logout">
                    <svg class="lf-icon" aria-hidden="true"><use href="@Url.Content("~/img/icons.svg")#box-arrow-right"></use></svg>
                    登出
                </button>
                <div class="lf-sidebar__version text-muted small">v@(appVersion)</div>
            </div>
        </aside>

        <div class="lf-main">
            <header class="lf-topbar lf-no-print">
                <h1 class="lf-topbar__title">@ViewData["Title"]</h1>
                <div class="btn-group btn-group-sm" role="group" aria-label="字級" id="lf-font-scale">
                    <button type="button" class="btn btn-outline-secondary" data-scale="small" title="小字級">小</button>
                    <button type="button" class="btn btn-outline-secondary" data-scale="medium" title="標準字級">中</button>
                    <button type="button" class="btn btn-outline-secondary" data-scale="large" title="大字級">大</button>
                </div>
            </header>

            @* 回到啟動精靈提示列（回饋十八輪批次H）：從精靈「前往設定」點過來時顯示，
               layout.js 依 ?from=setup 判斷是否要顯示，內容純前端組裝 *@
            <div id="lf-setup-return-banner" class="d-none lf-no-print"></div>

            <main class="lf-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/core/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
