  {
    "name": "互動-權限異動-勾選與批次確認視窗",
    "role": "ui-admin",
    "path": "fixture:page.permission-changes",
    "widths": [
      1280
    ],
    "steps": [
      {
        "waitFor": "#perm-list tbody tr"
      },
      {
        "click": "#perm-list tbody .lf-checkbox-cell input"
      },
      {
        "waitFor": "#perm-selection-bar:not(.d-none)"
      },
      {
        "click": "#btn-batch-suspicious"
      },
      {
        "waitFor": "#batch-confirm-modal.show"
      },
      {
        "assert": {
          "sel": "#batch-confirm-modal #batch-confirm-note",
          "visible": true
        }
      },
      {
        "assert": {
          "sel": "#batch-confirm-submit.btn-danger",
          "count": 1
        }
      },
      {
        "click": "#batch-confirm-modal .btn-close"
      }
    ]
  },
  {
    "name": "受限檢視者-權限異動",
