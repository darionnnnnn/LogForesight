  {
    "name": "互動-權限異動-全部展開與頁籤",
    "role": "ui-admin",
    "path": "fixture:page.permission-changes",
    "steps": [
      {
        "waitFor": "#perm-list tbody tr"
      },
      {
        "click": "#btn-toggle-expand"
      },
      {
        "waitFor": "#perm-list tr.lf-row-expandable[aria-expanded=\"true\"]"
      },
      {
        "assert": {
          "sel": "#btn-toggle-expand",
          "text": "全部收合"
        }
      },
      {
        "assert": {
          "sel": "#perm-list .lf-detail-plain",
          "visible": true
        }
      },
      {
        "click": "#btn-toggle-expand"
      },
      {
        "assert": {
          "sel": "#btn-toggle-expand",
          "text": "全部展開"
        }
      },
      {
        "click": "#perm-tabs [data-status=\"\"]"
      },
      {
        "waitFor": "#perm-list tbody tr .lf-text-title"
      },
      {
        "click": "#perm-list th[aria-sort] .lf-th-sort"
      },
      {
        "waitFor": "#perm-list .lf-th-sort--active"
      },
      {
        "assert": {
          "sel": "#perm-list tbody tr",
          "visible": true
        }
      },
      {
        "click": "#btn-toggle-expand"
      },
      {
        "waitFor": "#perm-list tr.lf-row-expandable[aria-expanded=\"true\"]"
      },
      {
        "assert": {
          "sel": "#perm-list .lf-detail-plain",
          "visible": true
        }
      },
      {
        "assert": {
          "sel": "#perm-list .lf-detail-plain, #perm-list table",
          "visible": true
        }
      }
    ]
