<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    LogForesight.Core 依賴 NuGet 套件 OpenCC（簡轉繁，docs/FEEDBACK-3-PLAN.md #7）。
    部分開發環境（Visual Studio 機器層級設定）啟用了 Package Source Mapping，卻沒有
    任何規則涵蓋 OpenCC，導致還原時報 NU1100「找不到來源」——即使 nuget.org 上確實有
    這個套件。這裡明確加一條規則，NuGet 會與機器/使用者層級既有的規則合併，
    不需要每個人各自去關閉或調整 Visual Studio 的全域 Package Source Mapping 設定。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="OpenCC" />
    </packageSource>
  </packageSourceMapping>
</configuration>
