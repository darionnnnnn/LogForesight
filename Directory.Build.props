<Project>
  <!--
    所有專案共用同一個版本號：報修時要能一眼確認回報者手上的站台是哪一次部署。
    MSBuild 會自動套用到同目錄與子目錄下所有專案，不必逐一在 .csproj 裡設定。

    版號規則 1.0.<輪次>.<修訂>（VersionRoundGuardTests 守住第三碼）：
    - 輪次＝docs/ 或 docs/archive/ 內 FEEDBACK-N-PLAN.md 的最大 N。開新一輪的第一個提交就改，修訂歸 0。
    - 修訂＝同一輪內「會交給使用者實測」的後續修正批次，各加 1：實作方自查修正、換模型體檢修正、
      併 dev 後依實測回饋的補修。同一批修正有多個 commit 只加一次。
    - 不屬於任何一輪的零星修補（直接在 dev 上的小修）：修訂加 1，輪次不動。
    - 前兩碼 1.0 是產品里程碑，只由使用者決定何時動。
    判斷站台部署了哪個 commit 一律看 BuildVersion.Current.Label（版號＋短 sha）。
  -->
  <PropertyGroup>
    <Version>1.0.82.0</Version>
    <!-- 平台專屬 API 呼叫一律視為錯誤：不得用 NoWarn／#pragma 壓制 -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>
  <!--
    分析規則升為建置錯誤的清單在根目錄 .editorconfig（正式碼；測試專案另行放寬）：CA2100／EF1002／EF1003（SQL 指令字串串接，
    值一律走參數）、CA5394（不安全亂數）、CA1310（文化相關字串比對）、CA5359（憑證驗證一律放行）。
    理由：這幾類問題在測試環境看不出來（SQLite 較寬鬆、測試不走真實憑證與文化），等到正式環境才爆，所以交給編譯器擋；
    合法使用處以 [SuppressMessage(…, Justification = "…")] 附理由放行，不在 .editorconfig 整檔關掉。
  -->
  <!--
    禁用 API 以符號比對（BannedSymbols.txt），別名、using static、換行寫法都擋得住；字串掃描守門擋不住這些。
    合法的使用處以 [SuppressMessage("ApiDesign", "RS0030", Justification = "…")] 附理由放行，不用白名單檔。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <!-- 正式碼的清單只套用 Core 與 Web：測試以 IPAddress.Parse("10.0.0.5") 建構固定位址是合理用法；
         測試專案另有自己的清單（LogForesight.Tests/BannedSymbols.txt） -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Condition="'$(MSBuildProjectName)' != 'LogForesight.Tests'" />
  </ItemGroup>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    <!-- 安全類分析規則全開（預設多數不啟用）；個別規則的嚴重度在根目錄 .editorconfig -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <!-- 相依弱點稽核涵蓋間接相依，有已知弱點即還原失敗（不是只出警告） -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
