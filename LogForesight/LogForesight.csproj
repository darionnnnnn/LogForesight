<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Models / Analysis / Persistence / Configuration / Service 已抽至共用類別庫，與 Web
             共用（docs/WEB-SPEC.md §2；Service 於 2026-07-31 隨 WEB-SCHEDULER-PLAN Phase 2 搬入）。
             本專案僅保留批次 CLI 專屬類別（SelfTestRunner／RuleImporter／NetiqProbeCli）與
             Program.cs（CLI 分派＋console 輸出 adapter）。 -->
        <ProjectReference Include="..\LogForesight.Core\LogForesight.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NLog" Version="6.1.4" />
        <PackageReference Include="Polly" Version="8.7.0" />
        <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="nlog.config">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- 讓 Tests 專案能直接單元測試 internal 的純函數（如 LogAnalysisService.ComputeRuleBasedRisk），
             不需要為了可測試性把內部實作細節公開成 public API。 -->
        <InternalsVisibleTo Include="LogForesight.Tests" />
    </ItemGroup>

</Project>
